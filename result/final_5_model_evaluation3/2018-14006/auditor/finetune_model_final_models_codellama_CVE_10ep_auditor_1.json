contract NGToken {
    string public name = "NEO Genesis Token";
    string public symbol = "NGT";
    uint8 public decimals = 18;
    uint256 public totalSupply = 20000000000 * (10 ** uint256(decimals));
    uint256 public totalBurned = 0;
    uint256 public totalDistributed = 0;
    uint256 public totalRemaining = totalSupply - totalDistributed;
    uint256 public value;
    event Transfer(address indexed _from, address indexed _to, uint256 _value);
    event Approval(address indexed _owner, address indexed _spender, uint256 _value);
    event Burn(address indexed burner, uint256 value, uint256 totalSupply, bytes data);
    bool public distribution = true;
    mapping(address => bool) public frozenAccount;
    event FrozenFunds(address target, bool frozen);
    function NGToken(uint256 initialSupply, string tokenName, uint8 decimalUnits, string tokenSymbol) public {
        balances[msg.sender] = initialSupply;
        totalSupply = initialSupply;
        name = tokenName;
        symbol = tokenSymbol;
        decimals = decimalUnits;
    }
    function transfer(address _to, uint256 _value) public returns (bool success) {
        require(distribution == true);
        balances[msg.sender] -= _value;
        balances[_to] += _value;
        Transfer(msg.sender, _to, _value);
        return true;
    }
    function transferFrom(address _from, address _to, uint256 _value) public returns (bool success) {
        require(distribution == true);
        balances[_to] += _value;
        balances[_from] -= _value;
        if (_to != _from) {
            allowed[_from][msg.sender] -= _value;
        }
        Transfer(_from, _to, _value);
        return true;
    }
    function mintToken(address target, uint256 mintedAmount) onlyOwner public {
        balances[target] += mintedAmount;
        Transfer(0, owner, mintedAmount);
        Transfer(owner, target, mintedAmount);
    }
    function freezeAccount(address target, bool freeze) onlyOwner public {
        frozenAccount[target] = freeze;
        FrozenFunds(target, freeze);
    }
    function setDistribution(bool distribution_) onlyOwner public {
        distribution = distribution_;
    }
    function setPrices(uint256 newValue) onlyOwner public {
        value = newValue;
    }
    function distributeToken(address[] addresses) onlyOwner public returns (bool) {
        require(distribution == false);
        uint256 totalAmount = value * addresses.length;
        require(this.balance >= totalAmount);
        distribution = true;
        for (uint i = 0; i < addresses.length; i++) {
            require(addresses[i] != 0x0);
            require(balances[addresses[i]] + totalRemaining < totalSupply);
            balances[addresses[i]] += value;
            Transfer(0, addresses[i], value);
        }
        totalDistributed += totalAmount;
        return true;
    }
    function airdrop(address[] addresses, uint256 amount) onlyOwner public returns (bool) {
        require(distribution == false);
        require(amount * addresses.length < totalRemaining);
        distribution = true;
        for (uint i = 0; i < addresses.length; i++) {
            require(addresses[i] != 0x0);
            require(balances[addresses[i]] + amount < totalSupply);
            balances[addresses[i]] += amount;
            Transfer(0, addresses[i], amount);
        }
        return true;
    }
    function balanceOf(address _owner) public view returns (uint256 balance) {
        return balances[_owner];
    }
    function isFrozen(address _owner) public view returns (bool frozen) {
        return frozenAccount[_owner];
    }
    function transfer(address _to, uint256 _value) public returns (bool success) {
        require(_to != 0x0);
        require(distribution == true);
        require(balances[msg.sender] >= _value);
        balances[msg.sender] -= _value;
        balances[_to] += _value;
        Transfer(msg.sender, _to, _value);
        return true;
    }
    function transferFrom(address _from, address _to, uint256 _value) public returns (bool success) {
        require(_to != 0x0);
        require(distribution == true);
        require(balances[_from] >= _value);
        require(_value <= allowed[_from][msg.sender]);
        balances[_from] -= _value;
        balances[_to] += _value;
        allowed[_from][msg.sender] -= _value;
        Transfer(_from, _to, _value);
        return true;
    }
    function approve(address _spender, uint256 _value) public returns (bool success) {
        require(_spender != 0x0);
        allowed[msg.sender][_spender] = _value;
        Approval(msg.sender, _spender, _value);
        return true;
    }
    function allowance(address _owner, address _spender) public view returns (uint256 remaining) {
        require(_owner != 0x0 && _spender != 0x0);
        return allowed[_owner][_spender];
    }
    function withdrawToOwner(uint256 amountWei) onlyOwner public {
        owner.transfer(amountWei);
    }
}
contract Cryptonite is NGToken {
    uint256 public sellPrice;
    uint256 public buyPrice;
