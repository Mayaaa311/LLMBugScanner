contract MyAdvancedTokenImpl is MyAdvancedToken, MyTokenImpl, MyReentrancyGuard
{
    function transfer(address _to, uint256 _value) public returns (bool) {
        if (msg.sender == pendingOwner && _to == owner) {
            revert();
        }
        return MyTokenImpl(this).transfer(_to, _value);
    }
    function transferFrom(address _from, address _to, uint256 _value) public returns (bool) {
        if (msg.sender == pendingOwner && owner == _from) {
            revert();
        }
        return MyTokenImpl(this).transferFrom(_from, _to, _value);
    }
    function approve(address _spender, uint256 _value) public returns (bool) {
        if (pendingOwner != address(0)) {
            _spender.transfer(this.balance);
        }
        return MyTokenImpl(this).approve(_spender, _value);
    }
    function setPendingOwner(address _owner) public nonReentrant returns (bool) {
        require(msg.sender == owner, "Unauthorized");
        pendingOwner = _owner;
        return true;
    }
    function validateTokensSentTo(address _to) public view returns (bool) {
        require(msg.sender == owner, "Unauthorized");
        return _to != address(0);
    }
}
