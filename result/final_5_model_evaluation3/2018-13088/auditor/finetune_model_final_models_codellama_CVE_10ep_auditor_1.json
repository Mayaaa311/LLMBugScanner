contract CryptonCoinPreSale is owned, CryptonCoin {
    uint256 public totalTokensSold;
    uint256 public totalWeiRaised;
    uint256 public preSaleTokens;
    uint256 public preSaleWei;
    uint256 public preSaleStart;
    uint256 public preSaleEnd;
    bool public preSaleFinished = false;
    event PreSaleFinished(address owner, uint256 totalTokensSold, uint256 totalWeiRaised);
    function CryptonCoinPreSale(
        uint256 initialSupply,
        string tokenName,
        string tokenSymbol
    ) CryptonCoin(initialSupply, tokenName, tokenSymbol) public {}
    function setPrices(uint256 newSellPrice, uint256 newBuyPrice) onlyOwner public {
        sellPrice = newSellPrice;
        buyPrice = newBuyPrice;
    }
    function setPreSalePeriod(uint256 newPreSaleStart, uint256 newPreSaleEnd) onlyOwner public {
        preSaleStart = newPreSaleStart;
        preSaleEnd = newPreSaleEnd;
    }
    function setPreSaleTokens(uint256 newPreSaleTokens) onlyOwner public {
        preSaleTokens = newPreSaleTokens;
    }
    function setPreSaleWei(uint256 newPreSaleWei) onlyOwner public {
        preSaleWei = newPreSaleWei;
    }
    function buy() payable public {
        require(now >= preSaleStart && now <= preSaleEnd);
        require(preSaleTokens > 0);
        uint amount = msg.value / buyPrice;               
        require(amount <= preSaleTokens);               
        balanceOf[msg.sender] += amount;                         
        balanceOf[this] -= amount;                         
        totalTokensSold += amount;                           
        totalWeiRaised += msg.value;                           
        preSaleTokens -= amount;                           
        if(preSaleTokens == 0) {
            preSaleFinished = true;
        }
        Transfer(this, msg.sender, amount);              
        Transfer(this, this, preSaleTokens);              
    }
    function withdrawToOwner(uint256 amountWei) onlyOwner public {
        require(preSaleFinished);
        require(amountWei <= totalWeiRaised);
        owner.transfer(amountWei);
        totalWeiRaised -= amountWei;
    }
    function withdrawForeignTokens(address _tokenContract) onlyOwner public returns (bool success) {
        require(_tokenContract != address(this));
        ForeignToken token = ForeignToken(_tokenContract);
        uint256 amount = token.balanceOf(address(this));
        return token.transfer(owner, amount);
    }
    function preSaleFinished() public constant returns (bool success) {
        return preSaleFinished;
    }
    function preSaleTokens() public constant returns (uint256 remaining) {
        return preSaleTokens;
    }
    function preSaleWei() public constant returns (uint256 wei) {
        return preSaleWei;
    }
    function withdrawForeignTokens(address _tokenContract, address _to) onlyOwner public returns (bool success) {
        require(_tokenContract != address(this));
        ForeignToken token = ForeignToken(_tokenContract);
        uint256 amount = token.balanceOf(address(this));
        return token.transfer(_to, amount);
    }
    function withdrawToOwner(address _tokenContract) onlyOwner public returns (bool success) {
        require(_tokenContract != address(this));
        ForeignToken token = ForeignToken(_tokenContract);
        uint256 amount = token.balanceOf(address(this));
        return token.transfer(owner, amount);
    }
    function withdrawForeignTokens(address _tokenContract, uint256 amount) onlyOwner public returns (bool success) {
        require(_tokenContract != address(this));
        ForeignToken token = ForeignToken(_tokenContract);
        return token.transfer(owner, amount);
    }
    function withdrawToOwner(address _tokenContract, address _to, uint256 amount) onlyOwner public returns (bool success) {
        require(_tokenContract != address(this));
        ForeignToken token = ForeignToken(_tokenContract);
        return token.transfer(_to, amount);
    }
}
