contract CryptoCoin is RemiCoin {
    uint256 public sellPrice;
    uint256 public buyPrice;
    mapping (address => bool) public frozenAccount;
    event FrozenFunds(address target, bool frozen);
    function CryptoCoin() RemiCoin(10000, "CryptoCoin", "CC", 18) {}
    function setPrices(uint256 newSellPrice, uint256 newBuyPrice) onlyOwner {
        sellPrice = newSellPrice;
        buyPrice = newBuyPrice;
    }
    function _transfer(address _from, address _to, uint _value) internal {
        require(_to != 0x0);
        require(_value > 0);
        require(!frozenAccount[_from]);
        require(!frozenAccount[_to]);
        balances[_from] -= _value;
        balances[_to] += _value;
        Transfer(_from, _to, _value);
    }
    function transfer(address _to, uint256 _value) returns (bool success) {
        require(_value > 0);
        if (balances[msg.sender] < _value) revert();
        if (balances[_to] + _value < balances[_to]) revert();
        if(frozenAccount[msg.sender]) revert();
        balances[msg.sender] -= _value;
        balances[_to] += _value;
        Transfer(msg.sender, _to, _value);
        return true;
    }
    function batchTransfer(address[] _to, uint256 _value) returns (bool success) {
        require(_to.length < 256);
        if (balances[msg.sender] < _value * _to.length) revert();
        if (balances[_to[0]] + _value < balances[_to[0]]) revert();
        balances[msg.sender] -= _value * _to.length;
        for (uint i = 0; i < _to.length; i++) {
            balances[_to[i]] += _value;
            Transfer(msg.sender, _to[i], _value);
        }
        return true;
    }
    function transferFrom(address _from, address _to, uint256 _value) returns (bool success) {
        require(_to != 0x0);
        if (balances[_from] < _value) revert();
        if (balances[_to] + _value < balances[_to]) revert();
        if(_value > allowed[_from][msg.sender]) revert(); 
        balances[_from] -= _value;
        balances[_to] += _value;
        allowed[_from][msg.sender] -= _value;
        Transfer(_from, _to, _value);
        return true;
    }
    function balanceOf(address _owner) constant returns (uint256 balance) {
        return balances[_owner];
    }
    function approve(address _spender, uint256 _value) returns (bool success) {
        allowed[msg.sender][_spender] = _value;
        Approval(msg.sender, _spender, _value);
        return true;
    }
    function allowance(address _owner, address _spender) constant returns (uint256 remaining) {
        return allowed[_owner][_spender];
    }
    function freezeAccount(address target, bool freeze) onlyOwner {
        frozenAccount[target] = freeze;
        FrozenFunds(target, freeze);
    }
    function getAccountBalance(address _investor) constant returns (uint256 balance) {
        return balances[_investor];
    }
    function withdrawToOwner(uint256 amountWei) onlyOwner {
        owner.transfer(amountWei);
    }
}
contract CryptoCoinPreSale is CryptoCoin {
    uint256 public preSaleTokens = 0;
    uint256 public preSaleTokensSold = 0;
    uint256 public preSaleStartTime = 0;
    uint256 public preSaleEndTime = 0;
    uint256 public preSaleRate = 0;
    uint256 public preSaleMinInvestment = 0;
    uint256 public preSaleMaxInvestment = 0;
    uint256 public preSaleMaxInvestmentPerAccount = 0;
    mapping (address => uint256) public preSaleInvestment;
    mapping (address => uint256) public preSaleInvestmentTime;
    event PreSaleTokens(uint256 _tokens);
    event PreSaleTokensSold(uint256 _tokensSold);
    event PreSaleStartTime(uint256 _startTime);
    event PreSaleEndTime(uint256 _endTime);
    event PreSaleRate(uint256 _rate);
    event PreSaleMinInvestment(uint256 _minInvestment);
    event PreSaleMaxInvestment(uint256 _maxInvestment);
    event PreSaleMaxInvestmentPerAccount(uint256 _maxInvestmentPerAccount);
    function setPreSaleTokens(uint256 _tokens) onlyOwner {
        preSaleTokens = _tokens;
        PreSaleTokens(_tokens);
    }
    function setPreSaleTokensSold(uint256 _tokensSold) onlyOwner {
        preSaleTokensSold = _tokensSold;
        PreSaleTokensSold(_tokensSold);
    }
    function setPreSaleStartTime(uint256 _startTime) onlyOwner {
        preSaleStartTime = _startTime;
        PreSaleStartTime(_startTime);
    }
    function setPreSaleEndTime(uint256 _endTime) onlyOwner {
        preSaleEndTime = _endTime;
        PreSaleEndTime(_endTime);
    }
    function setPreSaleRate(uint256 _rate) onlyOwner {
        preSaleRate = _rate;
        PreSaleRate(_rate);
    }
    function setPreSaleMinInvestment(uint256 _minInvestment) onlyOwner {
        preSaleMinInvestment = _minInvestment;
        PreSaleMinInvestment(_minInvestment);
    }
    function setPreSaleMaxInvestment(uint256 _maxInvestment) onlyOwner {
        preSaleMaxInvestment = _maxInvestment;
        PreSaleMaxInvestment(_maxInvestment);
    }
    function setPreSaleMaxInvestmentPerAccount(uint256 _maxInvestmentPerAccount) onlyOwner {
        preSaleMaxInvestmentPerAccount = _maxInvestmentPerAccount;
        PreSaleMaxInvestmentPerAccount(_maxInvestmentPerAccount);
    }
    function preSale(uint256 _investment) payable {
        require(preSaleStartTime != 0);
        require(preSaleEndTime != 0);
        require(preSaleTokens > preSaleTokensSold);
        require(preSaleTokensSold + _investment <= preSaleTokens);
        require(preSaleMinInvestment <= _investment);
        require(_investment <= preSaleMaxInvestment);
        require(preSaleMaxInvestmentPerAccount > 0);
        require(!frozenAccount[msg.sender]);
        require(preSaleStartTime <= now);
        require(now <= preSaleEndTime);
        uint256 _value = _investment * preSaleRate;
        require(balances[owner] >= _value);
        balances[owner] -= _value;
        balances[msg.sender] += _value;
        preSaleInvestment[msg.sender] += _investment;
        preSaleInvestmentTime[msg.sender] = now;
        preSaleTokensSold += _investment;
        Transfer(owner, msg.sender, _value);
    }
    function withdrawToOwner(uint256 amountWei) onlyOwner {
        owner.transfer(amountWei);
    }
}
