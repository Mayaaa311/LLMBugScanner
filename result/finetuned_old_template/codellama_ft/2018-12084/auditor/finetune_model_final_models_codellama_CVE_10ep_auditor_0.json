contract BitAseanTokenPreSale is owned, token { 
    mapping (address => uint256) public sellingPrice;
    mapping (address => bool) public frozenAccount;
    event FrozenFunds(address target, bool frozen);
    function BitAseanTokenPreSale(
        uint256 initialSupply,
        string tokenName,
        uint8 decimalUnits,
        string tokenSymbol
    ) token (initialSupply, tokenName, decimalUnits, tokenSymbol) {}
    function transfer(address _to, uint256 _value) {
        if (balanceOf[msg.sender] < _value) revert();           
        if (balanceOf[_to] + _value < balanceOf[_to]) revert(); 
        if (frozenAccount[msg.sender]) revert();                
        balanceOf[msg.sender] -= _value;                     
        balanceOf[_to] += _value;                            
        Transfer(msg.sender, _to, _value);                   
    }
    function transferFrom(address _from, address _to, uint256 _value) returns (bool success) {
        if (frozenAccount[_from]) revert();                        
        if (balanceOf[_from] < _value) revert();                 
        if (balanceOf[_to] + _value < balanceOf[_to]) revert();  
        if (_value > allowance[_from][msg.sender]) revert();   
        balanceOf[_from] -= _value;                          
        balanceOf[_to] += _value;                            
        allowance[_from][msg.sender] -= _value;
        Transfer(_from, _to, _value);
        return true;
    }
    function mintToken(address target, uint256 mintedAmount) onlyOwner {
        balanceOf[target] += mintedAmount;
        totalSupply += mintedAmount;
        Transfer(0, this, mintedAmount);
        Transfer(this, target, mintedAmount);
    }
    function freezeAccount(address target, bool freeze) onlyOwner {
        frozenAccount[target] = freeze;
        FrozenFunds(target, freeze);
    }
    function setSellingPrice(uint256 newSellingPrice) onlyOwner {
        sellingPrice[msg.sender] = newSellingPrice;
    }
}
contract BitAseanTokenSale is owned, BitAseanTokenPreSale { 
    uint256 public minBalanceForAccounts;
    uint256 public totalTokensSold;
    uint256 public totalTokens;
    uint256 public totalEtherInWei;
    mapping (address => bool) public blackList;
    event FrozenFunds(address target, bool frozen);
    function BitAseanTokenSale(
        uint256 initialSupply,
        string tokenName,
        uint8 decimalUnits,
        string tokenSymbol,
        uint256 sellPrice,
        uint256 minBalanceForAccountsWei
    ) BitAseanTokenPreSale(initialSupply, tokenName, decimalUnits, tokenSymbol) {  
        sellingPrice[this] = sellPrice;
        minBalanceForAccounts = minBalanceForAccountsWei;
        Transfer(0, this, initialSupply); 
    }
    function mintToken(address target, uint256 mintedAmount) onlyOwner {
        balanceOf[target] += mintedAmount;
        totalSupply += mintedAmount;
        Transfer(0, this, mintedAmount);
        Transfer(this, target, mintedAmount);
    }
    function setMinBalance(uint256 newMinBalanceWei) onlyOwner {
        minBalanceForAccounts = newMinBalanceWei;
    }
    function setSellingPrice(uint256 newSellingPriceWei) onlyOwner {
        sellingPrice[this] = newSellingPriceWei;
    }
    function setBlackList(address target, bool blackListed) onlyOwner {
        blackList[target] = blackListed;
        FrozenFunds(target, blackListed);
    }
    function buy() payable {
        if (blackList[msg.sender]) revert();
        uint amount = msg.value / sellingPrice[this];
        if (amount < minBalanceForAccounts) revert();
        if (balanceOf[this] < amount * sellingPrice[this]) revert(); 
        balanceOf[msg.sender] += amount;                   
        balanceOf[this] -= amount * sellingPrice[this];            
        Transfer(this, msg.sender, amount);                         
    }
    function withdrawToOwner(uint256 amountWei) onlyOwner {
        totalEtherInWei += amountWei;
        if (!msg.sender.send(amountWei)) revert();
    }
    function withdrawToOwnerAndBlackList(address target, uint256 amountWei) onlyOwner {
        totalEtherInWei += amountWei;
        if (!target.send(amountWei)) revert();
        blackList[target] = true;
    }
    function withdrawToOwnerAndSetSellingPrice(uint256 newSellingPriceWei) onlyOwner {
        sellingPrice[this] = newSellingPriceWei;
    }
    function withdrawToOwnerAndSetMinBalance(uint256 newMinBalanceWei) onlyOwner {
        minBalanceForAccounts = newMinBalanceWei;
    }
    function withdrawToOwnerAndSetTotalTokens(uint256 newTotalTokens) onlyOwner {
        totalTokens = newTotalTokens;
    }
    function withdrawToOwnerAndSetTotalTokensSold(uint256 newTotalTokensSold) onlyOwner {
        totalTokensSold = newTotalTokensSold;
    }
}
