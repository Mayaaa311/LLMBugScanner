contract SafeMath {
  function safeAdd(uint a, uint b) returns (uint c) {
    assert(b <= a);
    c = a + b;
    assert(c >= a);
  }
  function safeSub(uint a, uint b) returns (uint c) {
    assert(b <= a);
    c = a - b;
  }
  function safeMul(uint a, uint b) returns (uint c) {
    c = a * b;
    assert(a == 0 || c / a == b);
  }
  function safeDiv(uint a, uint b) returns (uint c) {
    assert(b > 0);
    c = a / b;
  }
}
