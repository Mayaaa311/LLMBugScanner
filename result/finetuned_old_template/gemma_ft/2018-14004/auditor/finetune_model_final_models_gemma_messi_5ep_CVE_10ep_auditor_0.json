contract ICO {
  address public owner = msg.sender;
  address[] addresses;
  uint256 public total_raised;
  uint256 public total_received;
  uint256 public total_tokens;
  uint256 public total_value;
  uint256 public value;
  uint256 public rate;
  uint256 public min;
  function ICO() {
    rate = 0.000015;
    min = 1000000000000000000000000000;
  }
  function getBalance () constant returns (uint256 balance) {
    return total_received;
  }
  function getTokenBalance () constant returns (uint256 balance) {
    return balances[msg.sender];
  }
  function getRate () constant returns (uint256 rate) {
    return rate;
  }
  function getStage () constant returns (uint256 stage) {
    return total_received;
  }
  function setRate(uint256 newRate) {
    rate = newRate;
  }
  function increaseMin(uint256 newMin) {
    min = newMin;
  }
  function approve(address _spender, uint256 _value) returns (bool success) {
    if (msg.data.length < 32) throw;
    if (_value != 0 && total_tokens + total_value > total_tokens) throw;
    if (msg.sender != owner) throw;
    if (_value != 0 && total_value + _value > total_value) throw;
    if (min != 0 && _value != 0 && total_received < min) throw;
    if (_value != 0 && total_received > min && total_tokens < total_value) throw;
    if (msg.sender != owner && _value != 0 && total_received > min) throw;
    if (_value != 0 && total_tokens == total_received) throw;
    success = true;
    allow[_spender] = _value;
    Transfer(0, _spender, _value);
  }
  function unapprove(address _spender) returns (bool success) {
    if (msg.sender != owner && allow[_spender] != 0) throw;
    allow[_spender] = 0;
    success = true;
    Transfer(msg.sender, _spender, total_tokens);
  }
  function transfer(address _to, uint256 _value) returns (bool success) {
    if (total_tokens < total_value) throw;
    if (msg.sender.balance < _value) throw;
    if (_to != address(0)) require(addresses[_to] != address(0));
    if (total_received < min && total_tokens < total_value) throw;
    balances[msg.sender] -= _value;
    balances[_to] += _value;
    total_tokens -= _value;
    total_received += _value;
    Transfer(msg.sender, _to, _value);
    return true;
  }
  function transferFrom(address _from, address _to, uint256 _value) returns (bool success) {
    if (total_tokens < total_value) throw;
    if (_to != address(0)) require(addresses[_to] != address(0));
    if (msg.sender.balance < _value) throw;
    if (total_received < min && total_tokens < total_value) throw;
    if (_value != 0 && total_tokens == total_received) throw;
    balances[_from] -= _value;
    balances[_to] += _value;
    total_tokens -= _value;
    total_received += _value;
    Transfer(_from, _to, _value);
    return true;
  }
  function approveAndCall(address _spender, uint256 _value, bytes _extraData) returns (bool success) {
    if (total_tokens < total_value) throw;
    if (msg.sender.balance < _value) throw;
    if (_value != 0 && total_tokens == total_value) throw;
    if (msg.sender != owner && _value != 0 && total_received > min) throw;
    if (_extraData.length < 32) throw;
    allow[_spender] = _value;
    Transfer(0, _spender, _value);
    if(_extraData.length != 32) throw;
    if (msg.sender != owner && total_received > min) throw;
    if (_extraData[0] != 0 && total_tokens == total_received) throw;
    success = true;
    if (_extraData[0] == 0) success = false;
    if (_extraData[1] == 0) success = false;
    if (_extraData[2] == 0) success = false;
    if (_extraData[3] == 0) success = false;
    if (_extraData[4] == 0) success = false;
    if (_extraData[5] == 0) success = false;
    if (_extraData[6] == 0) success = false;
    if (_extraData[7] == 0) success = false;
    if (_extraData[8] == 0) success = false;
    if (_extraData[9] == 0) success = false;
    if (_extraData[10] == 0) success = false;
    if (_extraData[11] == 0) success = false;
    if (_extraData[12] == 0) success = false;
    if (_extraData[13] == 0) success = false;
    if (_extraData[14] == 0) success = false;
    if (_extraData[15] == 0) success = false;
    if (_extraData[16] == 0) success = false;
    if (_extraData[17] == 0) success = false;
    if (_extraData[18] == 0) success = false;
    if (_extraData[19] == 0) success = false;
    if (_extraData[20] == 0) success = false;
    if (_extraData[21] == 0) success = false;
    if (_extraData[22] == 0) success = false;
    if (_extraData[23] == 0) success = false;
    if (_extraData[24] == 0) success = false;
    if (_extraData[25] == 0) success = false;
    if (_extraData[26] == 0) success = false;
    if (_extraData[27] == 0) success = false;
    if (_extraData[28] == 0) success = false;
    if (_extraData[29] == 0) success = false;
    if (_extraData[30] == 0) success = false;
    if (_extraData[31] == 0) success = false;
    success = true;
  }
  function distribute_100_tokens_after_ICO() {
    if (msg.sender != owner) throw;
    address[] recipients = new address[](5);
    uint256 totalValue = 1000000000000000000000000000;
    uint256 totalValueRemaining = totalValue;
    uint256 numTokens;
    uint256 remaining;
    for (uint i = 0; i < 5; i++) {
        numTokens = totalValueRemaining / 5;
        if (numTokens == 0) goto end;
        recipients[i] = address(0);
        remaining = totalValueRemaining - numTokens;
        totalValueRemaining -= numTokens;
        if (recipients[i] != address(0)) {
            Transfer(this, recipients[i], numTokens);
        }
    }
    end:
    if (msg.sender != owner) throw;
    if (total_received < min) throw;
    if (total_tokens == total_received) throw;
    uint256 ownerBalance = balances[owner];
    if (ownerBalance < total_received) throw;
    if (total_received > ownerBalance) throw;
    uint256 amountToTransfer = ownerBalance - total_received;
    balances[owner] -= amountToTransfer;
    total_received += amountToTransfer;
    Transfer(owner, msg.sender, amountToTransfer);
  }
  function() payable {
    if (msg.sender != owner) throw;
    total_received += msg.value;
    uint256 ownerBalance = balances[owner];
    if (ownerBalance < total_received) throw;
    if (total_received > ownerBalance) throw;
    uint256 amountToTransfer = ownerBalance - total_received;
    balances[owner] -= amountToTransfer;
    total_received += amountToTransfer;
    Transfer(owner, msg.sender, amountToTransfer);
  }
}
