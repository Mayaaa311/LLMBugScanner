  function _collectTokens(address target, uint256 amount) private {
    target.transfer(amount);
  }
  function _payout(address _to) private {
    _collectTokens(_to, amount);
  }
  function _refund(address _to) private {
    _collectTokens(_to, 0);
  }
  function _myRandom() private returns (uint256) {
    return random();
  }
  function _distributeFunds(uint256 _amount) private {
    require(msg.sender == CTO);
    uint256 balance = address(this).balance;
    if (balance < _amount) {
      _amount = balance;
    }
    distributeFunds(msg.sender, _amount);
  }
}
