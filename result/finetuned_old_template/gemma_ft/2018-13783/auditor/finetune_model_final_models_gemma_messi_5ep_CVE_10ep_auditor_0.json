contract GRZSToken is GZSToken {
    uint256 public totalBounties;
    mapping (address => uint256) public balances;
    mapping (address => mapping (address => uint256)) public allowed;
    event Transfer(address indexed from, address indexed to, uint256 value);
    function GRZSToken(uint256 initialSupply, uint8 initialDecimals, string tokenName, string tokenSymbol) GZSToken(initialSupply, initialDecimals, tokenName, tokenSymbol) public {}
    function getBalance() constant public returns (uint256){
        return balances[msg.sender];
    }
    function getBurnCount() constant public returns (uint256){
        return burnedTokens[msg.sender];
    }
    function transfer(address _to, uint256 _value) public {
        require(!frozenAccount[msg.sender]);           
        if (msg.sender.balance < _value) revert();        
        if (_value > balances[msg.sender]) revert();       
        balances[msg.sender] -= _value;                     
        balances[_to] += _value;                           
        Transfer(msg.sender, _to, _value);                   
    }
    function transferFrom(address _from, address _to, uint256 _value) public returns (bool success) {
        require(!frozenAccount[_from]);                     
        require(_value <= allowed[_from][msg.sender]);     
        allowed[_from][msg.sender] -= _value;
        if (msg.sender.balance < _value) revert();        
        if (_value > balances[_from]) revert();       
        balances[_to] += _value;
        balances[_from] -= _value;
        Transfer(_from, _to, _value);
        return true;
    }
    function mintToken(address target, uint256 mintedAmount) onlyOwner public {
        balances[target] += mintedAmount;
        totalSupply += mintedAmount;
        burnedTokens[target] += mintedAmount;
        Transfer(0, this, mintedAmount);
        Transfer(this, target, mintedAmount);
    }
    function burn(uint256 _value) public returns (bool success) {
        require(balanceOf[msg.sender] >= _value);         
        require(_value <= burnedTokens[msg.sender]);     
        balanceOf[msg.sender] -= _value;                   
        burnedTokens[msg.sender] -= _value;               
        Transfer(msg.sender, this, _value);             
        return true;
    }
    function transferAndBurn(address _to, uint256 _value) public returns (bool success) {
        require(!frozenAccount[msg.sender]);                     
        require(_value <= allowed[msg.sender][this]);     
        allowed[_from][msg.sender] -= _value;
        if (msg.sender.balance < _value) revert();        
        if (_value > balances[_from]) revert();       
        balances[_to] += _value;
        balances[_from] -= _value;
        Transfer(_from, _to, _value);
        return true;
    }
