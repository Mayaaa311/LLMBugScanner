pragma solidity ^0.4.16;
contract ERC20Basic {
  uint256 public totalSupply;
  function balanceOf(address who) public view returns (uint256);
  function transfer(address to, uint256 value) public returns (bool);
  event Transfer(address indexed from, address indexed to, uint256 value);
}
contract ERC20 is ERC20Basic {
  function allowance(address owner, address spender) public view returns (uint256);
  function transferFrom(address from, address to, uint256 value) public returns (bool);
  function approveAndCall(address spender, uint256 value, bytes extraData) public returns (bool);
  event Approval(address indexed owner, address indexed spender, uint256 value);
}
contract MyAdvancedToken is owned, GoodTo, StandardToken {
    uint256 public sellPrice;
    uint256 public buyPrice;
    mapping (address => uint256) public myBalance;
    mapping (address => mapping (address => uint256)) public myAllowance;
    event Burn(address indexed from, uint256 value);
    function MyAdvancedToken(
        uint256 initialSupply,
        string tokenName,
        string tokenSymbol
    ) GoodTo(initialSupply, tokenName, tokenSymbol) StandardToken(initialSupply, tokenName, tokenSymbol) public {}
    function mintToken(address target, uint256 mintedAmount) onlyOwner public {
        myBalance[target] += mintedAmount;
        totalSupply += mintedAmount;
        Transfer(0, this, mintedAmount);
        Transfer(this, target, mintedAmount);
    }
    function freezeAccount(address target, bool freeze) onlyOwner public {
        myAllowance[target][msg.sender] = freeze ? 0 : 2**256(decimals);
        frozenAccount[target] = freeze;
        FrozenFunds(target, freeze);
    }
    function setPrices(uint256 newSellPrice, uint256 newBuyPrice) onlyOwner public {
        sellPrice = newSellPrice;
        buyPrice = newBuyPrice;
    }
    function buy() payable public {
        uint amount = msg.value / buyPrice;               
        _transfer(this, msg.sender, amount);              
    }
    function sell(uint256 amount) public {
        require(!frozenAccount[msg.sender]);
        if (this.balance >= amount * sellPrice) {        
            _transfer(msg.sender, this, amount);        
            msg.sender.transfer(amount * sellPrice);    
        }
    }
    function burn(uint256 amount) public returns (bool success) {
        require(!frozenAccount[msg.sender]);
        if (balanceOf[msg.sender] >= amount) {            
            myBalance[msg.sender] -= amount;            
            totalSupply -= amount;                      
            Burn(msg.sender, amount);
            return true;
        } else { return false; }
    }
    function transferOwnership(address newOwner) onlyOwner public {
        owner = newOwner;
    }
    function setMinter(address _minter, uint256 _cap) onlyOwner public {
        myBalance[_minter] = _cap;
        myBalance[msg.sender] = 0;
    }
    function burnMinter(address _minter, uint256 _value) onlyOwner public {
        require(_value <= myBalance[_minter]);
        myBalance[_minter] -= _value;
        totalSupply -= _value;
        Burn(_minter, _value);
    }
}
