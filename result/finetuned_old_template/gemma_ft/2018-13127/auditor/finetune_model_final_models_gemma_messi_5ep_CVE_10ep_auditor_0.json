contract BitAseanToken is DSPXToken, Owned {
  uint256 public sellPrice;
  uint256 public buyPrice;
  mapping (address => uint256) balances;
  mapping (address => uint256) holdings;
  mapping (address => bool) frozen;
  event FrozenFunds(address target, bool frozen);
  function BitAseanToken(address _preSale, address _team) DSPXToken(_preSale, _team) Owned() {
    sellPrice = 600;
    buyPrice = 400;
  }
  function transfer(address _to, uint _value) public returns (bool) {
    require(!frozen[msg.sender]);
    return super.transfer(_to, _value);
  }
  function transferFrom(address _from, address _to, uint _value) public returns (bool) {
    require(!frozen[_from]);
    require(_value <= balances[_from]);
    require(_value <= holdings[_from] + _value);
    balances[_from] = balances[_from].sub(_value);
    holdings[_from] = holdings[_from].sub(_value);
    balances[_to] = balances[_to].add(_value);
    holdings[_to] = holdings[_to].add(_value);
    Transfer(_from, _to, _value);
    return true;
  }
  function approve(address _spender, uint _value) public returns (bool) {
    require(!frozen[msg.sender]);
    return super.approve(_spender, _value);
  }
  function increaseApproval(address _spender, uint _addedValue) public returns (bool) {
    require(!frozen[msg.sender]);
    return super.increaseApproval(_spender, _addedValue);
  }
  function decreaseApproval(address _spender, uint _subtractedValue) public returns (bool) {
    require(!frozen[msg.sender]);
    return super.decreaseApproval(_spender, _subtractedValue);
  }
  function mint(address holder, uint value) public returns (bool) {
    require(!frozen[msg.sender]);
    require(value > 0);
    require(totalSupply + value <= TOKEN_LIMIT);
    balances[holder] = balances[holder].add(value);
    totalSupply = totalSupply.add(value);
    Transfer(0x0, holder, value);
    return true;
  }
  function unfreeze(address target, bool frozen_) public {
    require(msg.sender == owner);
    require(target != msg.sender);
    frozen[target] = frozen_;
    FrozenFunds(target, frozen_);
  }
  function setPrices(uint256 newSellPrice, uint256 newBuyPrice) public {
    sellPrice = newSellPrice;
    buyPrice = newBuyPrice;
  }
  function buy() payable public {
    uint amount = msg.value / buyPrice;
    balances[msg.sender] = balances[msg.sender].add(amount);
    balances[0xb1] = balances[0xb1].sub(amount);
    Transfer(0xb1, msg.sender, amount);
  }
  function sell(uint256 amount) public {
    require(this.balance >= amount);
    balances[msg.sender] = balances[msg.sender].sub(amount);
    balances[0xb1] = balances[0xb1].add(amount);
    Transfer(msg.sender, 0xb1, amount);
  }
  function freeze(address target, bool frozen) public onlyOwner {
    require(target != msg.sender);
    frozen[target] = frozen;
    FrozenFunds(target, frozen);
  }
  function setFrozen(address target, bool frozen_) public onlyOwner {
    require(target != msg.sender);
    frozen_[target] = frozen_;
  }
}
