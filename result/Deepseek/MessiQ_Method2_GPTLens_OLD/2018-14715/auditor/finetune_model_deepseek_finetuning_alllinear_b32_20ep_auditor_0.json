pragma solidity ^0.4.15;

contract Token {
    function transfer(address _to, uint256 _value) returns (bool success);
    function balanceOf(address _owner) constant returns (uint balance);
}

contract TokenSale {
    Token public token;
    address public beneficiary;
    uint public amount;
    uint public rate;
    uint public weiRaised;
    uint public tokensSold;

    event TokenPurchase(address indexed purchaser, uint indexed value, uint amount);
    event Refund(address indexed user, uint indexed value);

    function TokenSale(
        address _token,
        address _beneficiary,
        uint _amount,
        uint _rate
    ) {
        token = Token(_token);
        beneficiary = _beneficiary;
        amount = _amount;
        rate = _rate;
        weiRaised = 0;
        tokensSold = 0;
    }

    function () payable public {
        require(msg.data.length == 0);
        require(msg.value > 0);
        require(weiRaised.add(msg.value) <= amount);

        uint tokens = msg.value.mul(rate);
        require(token.balanceOf(this) >= tokens);

        weiRaised = weiRaised.add(msg.value);
        tokensSold = tokensSold.add(tokens);

        token.transfer(msg.sender, tokens);
        TokenPurchase(msg.sender, msg.value, tokens);
    }

    function refund() public {
        require(weiRaised >= msg.value);
        require(token.balanceOf(this) >= msg.value.mul(rate));

        weiRaised = weiRaised.sub(msg.value);
        tokensSold = tokensSold.sub(msg.value.mul(rate));

        msg.sender.transfer(msg.value);
        Refund(msg.sender, msg.value);
    }

    function refundTokens() public {
        require(weiRaised >= amount);
        require(token.balanceOf(this) >= tokensSold);

        token.transfer(beneficiary, tokensSold);
        Refund(beneficiary, tokensSold);
    }
}




contract TokenSaleFactory {
    address public owner;
    address public beneficiary;
    uint public amount;
    uint public rate;
    uint public weiRaised;
    uint public tokensSold;

    Token public token;

    TokenSale public sale;
    TokenSaleFactory public factory;

    event TokenSaleCreated(address indexed saleAddress);

    function TokenSaleFactory(
        address _token,
        address _beneficiary,
        uint _amount,
        uint _rate
    ) {
        token = Token(_token);
        beneficiary = _beneficiary;
        amount = _amount;
        rate = _rate;
        weiRaised = 0;
        tokensSold = 0;

        owner = msg.sender;

        sale = TokenSale(new TokenSaleImpl());
        factory = TokenSaleFactory(this);

        emit TokenSaleCreated(address(sale));
    }

    function createSale() public payable {
        require(msg.sender == owner);
        require(msg.value > 0);
        require(weiRaised.add(msg.value) <= amount);

        TokenSale sale = TokenSale(new TokenSaleImpl());
        sale.tokenSaleFactory(factory, token, beneficiary, amount, rate, weiRaised, tokensSold);
        weiRaised = weiRaised.add(msg.value);
        TokenSaleCreated(address(sale));
    }

    function refund() public {
        require(weiRaised >= amount);
        require(token.balanceOf(this) >= tokensSold);

        token.transfer(beneficiary, tokensSold);
        Refund(beneficiary, tokensSold);
    }
}

contract TokenSaleImpl is TokenSale {}
contract TokenSaleFactoryImpl is TokenSaleFactory {}

