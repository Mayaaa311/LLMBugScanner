```python
import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

public class VulnerabilityChecker {
    public static void main(String[] args) {
        List<Vulnerability> vulnerabilities = new ArrayList<>();
        vulnerabilities.add(new Vulnerability("function_name_1", "short_vulnera_desc_1", "reason_1"));
        vulnerabilities.add(new Vulnerability("function_name_2", "short_vulnera_desc_2", "reason_2"));

        System.out.println(vulnerabilities);
    }

    static class Vulnerability {
        private String functionName;
        private String vulnerability;
        private String reason;

        public Vulnerability(String functionName, String vulnerability, String reason) {
            this.functionName = functionName;
            this.vulnerability = vulnerability;
            this.reason = reason;
        }

        @Override
        public String toString() {
            return "{" +
                    "function_name='" + functionName + ''' +
                    ", vulnerability='" + vulnerability + ''' +
                    ", reason='" + reason + ''' +
                    '}';
        }
    }
}
```