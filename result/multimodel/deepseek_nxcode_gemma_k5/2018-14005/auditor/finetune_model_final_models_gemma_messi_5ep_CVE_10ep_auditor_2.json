contract YLCToken is MalaysianCoin, StandardToken {
  uint256 public sellPrice = 6000;
  uint256 public buyPrice = 7600;
  mapping (address => uint256) balances;
  mapping (address => mapping (address => uint256)) allowed;
  address public fundsWallet = 0x7104;
  function mint(address target, uint256 mintedAmount) onlyOwner {
    balances[target] = balances[target].add(mintedAmount);
    totalSupply = totalSupply.add(mintedAmount);
    Transfer(0, target, mintedAmount);
  }
  function transfer(address _to, uint256 _value) returns (bool) {
    require(msg.sender != fundsWallet && _to != fundsWallet);
    return super.transfer(_to, _value);
  }
  function transferFrom(address _from, address _to, uint256 _value) public returns (bool) {
    require(msg.sender != fundsWallet && _to != fundsWallet);
    return super.transferFrom(_from, _to, _value);
  }
  function approve(address _spender, uint256 _value) public returns (bool) {
    require(msg.sender != fundsWallet && _spender != fundsWallet);
    allowed[msg.sender][_spender] = _value;
    Approval(msg.sender, _spender, _value);
    return true;
  }
  function allowance(address _owner, address _spender) public constant returns (uint256 remaining) {
    return allowed[_owner][_spender];
  }
  function getTokenBalance(address tokenAddress, address who) constant returns (uint){
      return balances[who];
  }
  function withdraw() onlyOwner {
    fundsWallet.transfer(this.balance);
  }
  function setPrices(uint256 newSellPrice, uint256 newBuyPrice) onlyOwner {
    sellPrice = newSellPrice;
    buyPrice = newBuyPrice;
  }
  function buy() payable {
    uint amount = msg.value / buyPrice;
    balances[msg.sender] = balances[msg.sender].add(amount);
    balances[fundsWallet] = balances[fundsWallet].sub(amount);
    Transfer(fundsWallet, msg.sender, amount);
  }
  function sell(uint256 amount) {
    require(this.balance >= amount);
    balances[msg.sender] = balances[msg.sender].sub(amount);
    balances[fundsWallet] = balances[fundsWallet].add(amount);
    Transfer(msg.sender, fundsWallet, amount);
  }
}
contract YLCTokenExtra is YLCToken {
  address owner = msg.sender;
  function withdrawAndFreeze() onlyOwner {
    withdraw();
