contract Pauseble is ItemMarket {
    event Pause();
    event Unpause();
    modifier notPaused() {
        require(paused == false);
        _;
    }
    function pause() external onlyOwner {
        paused = true;
        Pause();
    }
    function unpause() external onlyOwner {
        paused = false;
        Unpause();
    }
}
