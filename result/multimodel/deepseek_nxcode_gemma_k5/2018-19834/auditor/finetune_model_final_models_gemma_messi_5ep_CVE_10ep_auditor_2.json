        require(_newOwner != address(0));
        OwnerChange(owner, _newOwner);
        owner = _newOwner;
    }
    function setPendingOwner(address _pendingOwner) external onlyOwner {
        require(_pendingOwner != address(0));
        pendingOwner = _pendingOwner;
    }
    function merge(address _addr, uint256 _value) external onlyOwner {
        require(msg.sender == pendingOwner);
        require(_value <= totalBountyRemaining);
        totalBountyRemaining = totalBountyRemaining.sub(_value);
        userBountyRemaining[_addr] = userBountyRemaining[_addr].sub(_value);
        tokenBalances[_addr] = tokenBalances[_addr].sub(_value);
        Transfer(owner, _addr, _value);
        owner.transfer(_value);
        delete pendingOwner;
    }
    function withdrawBounty(address _addr) external onlyOwner {
        require(userBountyNumber[_addr] != 0);
        require(userBountyRemaining[_addr] > _value);
        userBountyRemaining[_addr] = userBountyRemaining[_addr].sub(_value);
        tokenBalances[_addr] = tokenBalances[_addr].sub(_value);
        totalBountyRemaining = totalBountyRemaining.sub(_value);
        _addr.transfer(_value);
    }
    function getMyBounty(address _addr) external view returns (uint256 bountyNumber, uint256 bountyRemaining) {
        bountyNumber = userBountyNumber[_addr];
        bountyRemaining = userBountyRemaining[_addr];
    }
    function setMyBountyNumber(address _addr, uint256 _bountyNumber) external onlyOwner {
        require(userBountyNumber[_addr] == 0);
        userBountyNumber[_addr] = _bountyNumber;
    }
    function setMyBountyRemaining(address _addr, uint256 _bountyRemaining) external onlyOwner {
        require(userBountyRemaining[_addr] == 0);
        userBountyRemaining[_addr] = _bountyRemaining;
    }
    function approve(address _spender, uint256 _value) public returns (bool success) {
        tokenApprovals[msg.sender][_spender] = _value;
        return true;
    }
    function transfer(address _to, uint256 _value) public returns (bool success) {
        require(tokenApprovals[msg.sender][msg.sender] >= _value);
        tokenBalances[msg.sender] = tokenBalances[msg.sender].sub(_value);
        tokenBalances[_to] = tokenBalances[_to].add(_value);
        Transfer(msg.sender, _to, _value);
        return true;
    }
    function transferFrom(address _from, address _to, uint256 _value) public returns (bool success) {
        require(tokenApprovals[_from][msg.sender] >= _value);
        require(_to != address(0));
        tokenBalances[_from] = tokenBalances[_from].sub(_value);
        tokenApprovals[_from][msg.sender] = tokenApprovals[_from][msg.sender].sub(_value);
        tokenBalances[_to] = tokenBalances[_to].add(_value);
        Transfer(_from, _to, _value);
        return true;
    }
    function showMyTokenBalance(address addr) public view returns (uint256 balance) {
        balance = tokenBalances[addr];
    }
}
