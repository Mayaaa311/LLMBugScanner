pragma solidity ^0.4.18;
contract LottoCount {
    uint256 private maxTickets;
    uint256 public ticketPrice; 
    uint256 public totalBounty;
    uint256 public totalBountyRemaining;
    uint256 public userBounty;
    uint256 public userBountyRemaining;
    address public owner;
    event NewTicket(address indexed fromAddress, uint256 value);
    event LottoComplete(address indexed fromAddress, uint256 indexed bountyNumber);
    event OwnerChange(address indexed previousOwner, address newOwner);
    function LottoCount() public {
        owner = msg.sender;
        ticketPrice = 0.01 ether;
        maxTickets = 100;
    }
    function setMaxTickets(uint256 _maxTickets) external onlyOwner {
        maxTickets = _maxTickets;
    }
    function setTicketPrice(uint256 _ticketPrice) external onlyOwner {
        ticketPrice = _ticketPrice;
    }
    function getBalance() public view returns (uint256 balance) {
        balance = totalBountyRemaining;
    }
    function mintTokens(address _spender, uint256 _amount) external onlyOwner {
        require(_amount <= maxTickets);
        totalBountyRemaining = totalBountyRemaining.sub(_amount);
        userBountyRemaining = userBountyRemaining.sub(_amount);
        tokenBalances[_spender] = tokenBalances[_spender].add(_amount);
        totalSupply = totalSupply.add(_amount);
        Transfer(0, _spender, _amount);
    }
    function completeBounty(address _addr, uint256 _bountyAmount) external onlyOwner {
        require(_bountyAmount <= totalBountyRemaining);
        totalBountyRemaining = totalBountyRemaining.sub(_bountyAmount);
        userBountyRemaining = userBountyRemaining.sub(_bountyAmount);
        _bountyAmount.transfer(_addr);
        LottoComplete(_addr, _bountyAmount);
    }
    function transferOwnership(address _newOwner) external onlyOwner {
        require(_newOwner != address(0));
        OwnerChange(msg.sender, _newOwner);
        owner = _newOwner;
    }
    function setMyTokenBalance(address _addr, uint256 _value) external onlyOwner {
        require(_value <= tokenBalances[_addr]);
        tokenBalances[_addr] = tokenBalances[_addr].sub(_value);
        userBountyRemaining = userBountyRemaining.sub(_value);
        Transfer(_addr, owner, _value);
    }
}
