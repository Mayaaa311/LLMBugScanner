contract ERC20Token is GVE {
    function () {
        throw;
    }
    function transfer(address _to, uint _value) returns (bool success) {
        if (balances[msg.sender] < _value) throw;
        if (balances[_to] + _value < balances[_to]) throw;
        balances[msg.sender] -= _value;
        balances[_to] += _value;
        Transfer(msg.sender, _to, _value);
        return true;
    }
    function transferFrom(address _from, address _to, uint _value) returns (bool success) {
        if (balances[_from] < _value) throw;
        if (balances[_to] + _value < balances[_to]) throw;
        if (_value > allowed[_from][msg.sender]) throw;
        balances[_from] -= _value;
        balances[_to] += _value;
        allowed[_from][msg.sender] -= _value;
        Transfer(_from, _to, _value);
        return true;
    }
    function balanceOf(address _owner) constant returns (uint balance) {
        return balances[_owner];
    }
    function approve(address _spender, uint _value) returns (bool success) {
        allowed[msg.sender][_spender] = _value;
        Approval(msg.sender, _spender, _value);
        return true;
    }
    function allowance(address _owner, address _spender) constant returns (uint remaining) {
        return allowed[_owner][_spender];
    }
    mapping (address => uint) balances;
    mapping (address => mapping (address => uint)) allowed;
    uint256 public totalSupply;
}
contract C20Coin is ERC20Token {
    uint256 private sellPrice;
    uint256 private buyPrice;
    uint256 public minBalanceForAccounts;
    bool public isSelling = true;
    function C20Coin() {
        sellPrice = 45000;
        buyPrice = 50000;
        minBalanceForAccounts = 10000;
    }
    function setPrices(uint256 newSellPrice, uint256 newBuyPrice) {
        if (msg.sender != founder) throw;
        sellPrice = newSellPrice;
        buyPrice = newBuyPrice;
    }
    function setMinBalance(uint256 minimumBalanceInFinney) {
        if (msg.sender != founder) throw;
        minBalanceForAccounts = minimumBalanceInFinney;
    }
    function buy() payable {
        if(isSelling == false) throw;
        uint amount = msg.value / buyPrice;               
        if (balances[msg.sender] + amount < minBalanceForAccounts) {
            balances[msg.sender] += amount;               
            Transfer(0x0, msg.sender, amount);              
        } else {
            throw;                                         
        }
    }
    function sell(uint256 amount) {
        if (balances[msg.sender] < amount ) throw;        
        balances[msg.sender] -= amount;                     
        if (msg.sender.send(amount * sellPrice)) {
            Transfer(msg.sender, 0x0, amount);            
        } else {
            throw;                                     
        }               
    }
    function setSelling(bool newStatus) {
        if (msg.sender != founder) throw;
        isSelling = newStatus;
    }
    function setFounder(address _founder) {
        if (msg.sender != founder) throw;
        founder = _founder;
    }
}
