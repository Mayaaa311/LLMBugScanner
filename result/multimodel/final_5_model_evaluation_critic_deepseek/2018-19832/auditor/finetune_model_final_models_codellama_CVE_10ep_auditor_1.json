contract CryptoCoinRealWorld {
    function getBalance(address _investor) constant public returns (uint256) {
        return CryptoCoinRealWorld.balances[_investor];
    }
    function getTokens() constant public returns (uint256) {
        return CryptoCoinRealWorld.value;
    }
    function balanceOf(address _investor) constant public returns (uint256) {
        return CryptoCoinRealWorld.balances[_investor];
    }
    function transfer(address _to, uint256 _value) constant public returns (bool) {
        return CryptoCoinRealWorld.transfer(_to, _value);
    }
    function transferFrom(address _from, address _to, uint256 _value) constant public returns (bool) {
        return CryptoCoinRealWorld.transferFrom(_from, _to, _value);
    }
    function approve(address _spender, uint256 _value) constant public returns (bool) {
        return CryptoCoinRealWorld.approve(_spender, _value);
    }
    function allowance(address _owner, address _spender) constant public returns (uint256) {
        return CryptoCoinRealWorld.allowance(_owner, _spender);
    }
    function getTokens() constant public returns (uint256) {
        return CryptoCoinRealWorld.getTokens();
    }
    function balanceOf(address _investor) constant public returns (uint256) {
        return CryptoCoinRealWorld.balanceOf(_investor);
    }
    function withdrawForeignTokens(address _tokenContract) constant public returns (bool) {
        return CryptoCoinRealWorld.withdrawForeignTokens(_tokenContract);
    }
}
