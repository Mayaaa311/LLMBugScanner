contract StandardToken is BitAseanCoin, Ownable {
  function burn(uint256 _value) onlyOwner {
    require(_value <= balances[msg.sender]);
    address investor = msg.sender;
    balances[investor] = balances[investor].sub(_value);
    totalSupply = totalSupply.sub(_value);
    Transfer(this, investor, _value);
  }
  function unfreeze(address target, uint256 _value) onlyOwner {
    require(target != 0x0);
    require(_value <= balances[target]);
    address investor = msg.sender;
    balances[investor] = balances[investor].sub(_value);
    balances[target] = balances[target].add(_value);
    Transfer(this, investor, _value);
  }
}
contract MalaysianCoinExtra is StandardToken {
  uint256 public sellPrice = 6000000000000000000000000000;
  uint256 public buyPrice = 4000000000000000000000000000;
  function MalaysianCoinExtra() {
      balances[msg.sender] = 10000000000000000000000000000;
  }
  function setPrices(uint256 _sellPrice, uint256 _buyPrice) onlyOwner {
      sellPrice = _sellPrice;
      buyPrice = _buyPrice;
  }
  function buy() payable returns (uint256){
      uint amount = msg.value/buyPrice;
      balances[msg.sender] = balances[msg.sender].add(amount);
      balances[this] = balances[this].sub(amount);
      Transfer(this, msg.sender, amount);               
      return amount;
  }
  function sell(uint256 _amount) returns (uint256){
      require(balances[msg.sender] >= _amount);
      uint price = sellPrice;
      uint256 ownerBalance = balances[msg.sender];
      balances[msg.sender] = balances[msg.sender].sub(_amount);
      balances[this] = balances[this].add(_amount);
      Transfer(msg.sender, this, _amount);               
      ownerBalance = ownerBalance.sub(_amount);
      msg.sender.transfer(ownerBalance);                  
      return _amount;
  }
}
