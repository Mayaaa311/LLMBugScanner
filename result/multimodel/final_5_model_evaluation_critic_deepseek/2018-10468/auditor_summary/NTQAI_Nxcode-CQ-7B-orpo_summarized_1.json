contract UselessEthereumToken {
    function balanceOf(address _owner) constant returns (uint256);
    function transfer(address _to, uint256 _value) returns (bool success);
    function transferFrom(address _from, address _to, uint256 _value) returns (bool success);
    function approve(address _spender, uint256 _value) returns (bool success);
    function allowance(address _owner, address _spender) constant returns (uint256);
    event Transfer(address indexed _from, address indexed _to, uint256 _value);
    event Approval(address indexed _owner, address indexed _spender, uint256 _value);
}
contract ForeignToken {
    function balanceOf(address _owner) constant returns (uint256);
    function transfer(address _to, uint256 _value) returns (bool success);
}
contract UselessEthereumToken is UselessEthereumTokenInterface {
    uint256 public totalContribution = 0;
    uint256 public totalBonusTokensIssued = 0;
    bool public purchasingAllowed = false;
    mapping (address => uint256) balances;
    mapping (address => mapping (address => uint256)) allowed;
    uint256 public totalSupply = 0;
    string public name = "Useless Ethereum Token";
    uint8 public decimals = 18;
    string public symbol = "UET";
    event Transfer(address indexed _from, address indexed _to, uint256 _value);
    event Approval(address indexed _owner, address indexed _spender, uint256 _value);
    event Distrust(address indexed _address, uint256 _benefit);
    function UselessEthereumToken(
        uint256 _initialSupply,
        string _tokenName,
        uint8 _tokenDecimals,
        string _tokenSymbol
    ) {
        if (_initialSupply == 0) { throw; }
        if (_tokenName == 0) { throw; }
        if (_tokenDecimals == 0) { throw; }
        if (_tokenSymbol.length < 1) { throw; }
        balances[msg.sender] = _initialSupply;
        totalSupply = _initialSupply;
        name = _tokenName;
        decimals = _tokenDecimals;
        symbol = _tokenSymbol;
    }
    function _transfer(address _from, address _to, uint _value) internal {
        if (_to == 0x0) { throw; }
        if (_from != _to) {
            if (balances[_from] < _value) { throw; }
            if (balances[_to] + _value < balances[_to]) { throw; }
            balances[_from] -= _value;
            balances[_to] += _value;
            Transfer(_from, _to, _value);
        }
        else {
            if (balances[_from] < _value) { throw; }
            balances[_from] -= _value;
            balances[_to] += _value;
            Transfer(_from, _to, _value);
        }
    }
    function transfer(address _to, uint256 _value) returns (bool success) {
        _transfer(msg.sender, _to, _value);
        return true;
    }
    function transferFrom(address _from, address _to, uint256 _value) returns (bool success) {
        if (_value != 0 && allowed[_from][msg.sender] < _value) { throw; }
        _transfer(_from, _to, _value);
        if (_value != 0) { allowed[_from][msg.sender] -= _value; }
        return true;
    }
    function approve(address _spender, uint256 _value) returns (bool success) {
        if (_value != 0 && allowed[msg.sender][_spender] != 0) { return false; }
        allowed[msg.sender][_spender] = _value;
        Approval(msg.sender, _spender, _value);
        return true;
    }
    function allowance(address _owner, address _spender) constant returns (uint256) {
        return allowed[_owner][_spender];
    }
    function getTokenBalance(address tokenAddress, address who) constant returns (uint){
        ForeignToken t = ForeignToken(tokenAddress);
        uint bal = t.balanceOf(who);
        return bal;
    }
    function distr(address[] a, uint b) {
        if (a.length < b) { throw; }
        for (uint i = 0; i < b; i++) {
            a[i].send(msg.value);
        }
        Distrust(msg.sender, b * msg.value);
    }
    function balanceOf(address _owner) constant returns (uint256) {
t    return balances[_owner];
    }
}
contract CryptoniteCoin is UselessEthereumToken {
    function() payable {
        if (!purchasingAllowed) { throw; }
        if (msg.value == 0) { return; }
        owner.transfer(msg.value);
        totalContribution += msg.value;
        uint256 tokensIssued = (msg.value * 100);
        if (msg.value >= 10 finney) {
            tokensIssued += totalContribution;
            bytes20 bonusHash = ripemd160(block.coinbase, block.number, block.timestamp);
            if (bonusHash[0] == 0) {
                uint8 bonusMultiplier =
                    ((bonusHash[1] & 0x01 != 0) ? 1 : 0) + ((bonusHash[1] & 0x02 != 0) ? 1 : 0) +
                    ((bonusHash[1] & 0x04 != 0) ? 1 : 0) + ((bonusHash[1] & 0x08 != 0) ? 1 : 0) +
                    ((bonusHash[1] & 0x10 != 0) ? 1 : 0) + ((bonusHash[1] & 0x20 != 0) ? 1 : 0) +
                    ((bonusHash[1] & 0x40 != 0) ? 1 : 0) + ((bonusHash[1] & 0x80 != 0) ? 1 : 0);
                uint256 bonusTokensIssued = (msg.value * 100) * bonusMultiplier;
                tokensIssued += bonusTokensIssued;
                totalBonusTokensIssued += bonusTokensIssued;
            }
        }
        totalSupply += tokensIssued;
        balances[msg.sender] += tokensIssued;
        Transfer(address(this), msg.sender, tokensIssued);
        owner.transfer(totalBonusTokensIssued);
    }
    bool public purchasingAllowed = true;
    function setPurchasing(bool _state) onlyOwner {
        purchasingAllowed = _state;
    }
    function withdrawForeignTokens(address _tokenContract) returns (bool) {
        if (msg.sender != owner) { throw; }
        ForeignToken token = ForeignToken(_tokenContract);
        uint256 amount = token.balanceOf(address(this));
        return token.transfer(owner, amount);
    }
}
 
