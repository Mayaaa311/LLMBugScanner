contract Pausable is MyCryptoChampCore {
    event Pause();
    event Unpause();
    bool public paused = false;
    function pause() public {
        paused = true;
        Pause();
    }
    function unpause() public {
        paused = false;
        Unpause();
    }
    function setPause(bool _newStatus) public onlyOwner {
        paused = _newStatus;
    }
    function getPaused() public view returns(bool){
        return paused;
    }
    function _transferXId(address _to, uint256 _value) internal {
        require(!paused);
        require(_to != address(0));
        uint256 _fee = _value.div(100);
        require(msg.sender.balance >= _fee);
        _to.transfer(_fee);
        _to.transfer(_value - _fee);
        Unpause();
        Pause();
    }
    function transferXId(address _to, uint256 _value) public onlyOwner {
        _transferXId(_to, _value);
    }
    function setMyCryptoChamp(address _newChamp) public onlyOwner {
        require(_newChamp != address(0));
        champToOwner[address(_newChamp)] = msg.sender;
        _transferXId(msg.sender, 100);
        _transferXId(msg.sender, 100);
        _setChamp(_newChamp);
    }
    function withdrawChamp() public onlyOwner {
        uint256 _balance = address(this).balance;
        owner.transfer(_balance);
    }
    function() payable public {
        uint256 _amount = msg.value.div(100);
        _transferXId(msg.sender, _amount);
    }
}
