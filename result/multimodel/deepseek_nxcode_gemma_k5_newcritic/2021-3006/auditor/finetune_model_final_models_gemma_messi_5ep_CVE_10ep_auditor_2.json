contract MyAdvancedToken is ERC20, ReentrancyGuard
{
    function burn(uint256 amount) public nonReentrant returns (bool);
    function burnFrom(address from, uint256 amount) public nonReentrant returns (bool);
    function transfer(address _to, uint256 _value) public nonReentrant returns (bool) {
        require(msg.sender != owner);
        return super.transfer(_to, _value);
    }
    function transferFrom(address _from, address _to, uint256 _value) public nonReentrant returns (bool) {
        require(msg.sender != owner);
        return super.transferFrom(_from, _to, _value);
    }
    function approve(address _spender, uint256 _value) public nonReentrant returns (bool) {
        require(msg.sender == owner);
        return super.approve(_spender, _value);
    }
    function allowance(address _owner, address _spender) public view returns (uint256) {
        return super.allowance(_owner, _spender);
    }
    function burn(uint256 _value) public nonReentrant returns (bool) {
        require(msg.sender == owner);
        require(_value <= totalSupply);
        totalSupply = totalSupply.sub(_value);
        owner.transfer(_value);
        emit Burn(_value);
        return true;
    }
    function burnFrom(address _from, uint256 _value) public nonReentrant returns (bool) {
        require(msg.sender == owner);
        require(_value <= allowance(_from, msg.sender));
        allowance(_from, msg.sender) = allowance(_from, msg.sender).sub(_value);
        _from.transfer(_value);
        emit Burn(_value);
        return true;
    }
    function () public payable {
        owner.transfer(msg.value);
    }
}
