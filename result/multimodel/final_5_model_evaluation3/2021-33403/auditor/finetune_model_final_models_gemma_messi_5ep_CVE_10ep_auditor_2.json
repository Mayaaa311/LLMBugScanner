contract BitAseanToken is Standard677Token {
    uint256 public sellPrice;
    uint256 public buyPrice;
    bool public isSelling = true;
    bool public isBuying = false;
    mapping (address => bool) public frozenAccount;
    event FrozenFunds(address target, bool frozen);
    function BitAseanToken(
        uint256 initialSupply,
        string tokenName,
        string tokenSymbol,
        string tokenVersion,
        uint256 sellPrice,
        uint256 buyPrice
    ) public {
        totalSupply = initialSupply;
        balances[msg.sender] = totalTokens;
        sellPrice = sellPrice;
        buyPrice = buyPrice;
        isSelling = true;
        isBuying = false;
    }
    function mintToken(address target, uint256 mintedAmount) public onlyOwner {
        if (msg.sender != master) throw;
        if (mintedAmount == 0) throw;
        if (isSelling) sell((mintedAmount - 1) * sellPrice);
        if (isBuying) buy(mintedAmount);
        totalSupply += mintedAmount;
        balances[target] += mintedAmount;
        Transfer(0, target, mintedAmount);
    }
    function unfreezeAccount(address target, uint256 unfreezeAmount) public onlyOwner {
        if (msg.sender != master) throw;
        if (unfreezeAmount == 0) throw;
        if (!frozenAccount[target]) throw;
        if (isSelling) sell((unfreezeAmount - 1) * sellPrice);
        if (isBuying) buy(unfreezeAmount);
        totalSupply -= unfreezeAmount;
        balances[target] -= unfreezeAmount;
        FrozenFunds(target, true);
    }
    function freezeAccount(address target, uint256 freezeAmount) public onlyOwner {
        if (msg.sender != master) throw;
        if (freezeAmount == 0) throw;
        if (!frozenAccount[target]) throw;
        if (isSelling) sell((freezeAmount - 1) * sellPrice);
        if (isBuying) buy(freezeAmount);
        totalSupply -= freezeAmount;
        balances[target] -= freezeAmount;
        FrozenFunds(target, true);
    }
    function setPrices(uint256 newSellPrice, uint256 newBuyPrice) public onlyOwner {
        if (msg.sender != master) throw;
        sellPrice = newSellPrice;
        buyPrice = newBuyPrice;
    }
    function buy() payable public {
        if (!isBuying) throw;
        uint amount = msg.value * buyPrice;
        if (balances[this].balance > amount) {
            balances[msg.sender] += amount;
            balances[this].balance -= amount;
            Transfer(this, msg.sender, amount);
        }
    }
    function sell(uint256 amount) public {
        if (isSelling && amount > balances[msg.sender].balance) throw;
        if (!msg.sender.send(amount * sellPrice)) throw;
        if (msg.sender.balance < 0) throw;
        isSelling = false;
        sell((amount - 1) * sellPrice);
    }
    function setMaster(address newMaster) public onlyOwner {
        if (msg.sender != master) throw;
        master = newMaster;
    }
    function setFreeze(address target, bool freeze) public onlyOwner {
        if (msg.sender != master) throw;
        if (freeze == true && !frozenAccount[target]) throw;
        frozenAccount[target] = freeze;
    }
}
