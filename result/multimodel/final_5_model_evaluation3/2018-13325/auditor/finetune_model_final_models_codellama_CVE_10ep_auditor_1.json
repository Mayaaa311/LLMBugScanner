contract GrowToken is owned, Token {
    uint256 public sellPrice; 
    uint256 public buyPrice;
    bool public sellOpen;
    bool public buyOpen;
    mapping (address => bool) public frozenAccount;
    event FrozenFunds(address target,bool freeze);
    function GrowToken(
        uint256 initialSupply,
        string tokenName,
        uint8 decimalUnits,
        string tokenSymbol
    ) Token (initialSupply, tokenName, decimalUnits, tokenSymbol) {}
    function transfer(address _to, uint256 _value) public returns (bool success) {
        require(balanceOf[msg.sender] >= _value);
        require(_to != address(0));
        require(!frozenAccount[msg.sender]);
        balanceOf[msg.sender] -= _value;
        balanceOf[_to] += _value;
        Transfer(msg.sender, _to, _value);
        return true;
    }
    function transferFrom(address _from, address _to, uint256 _value) public returns (bool success) {
        require(_value <= allowance[_from][msg.sender]);     
        allowance[_from][msg.sender] -= _value;
        balanceOf[_from] -= _value;
        balanceOf[_to] += _value;
        Transfer(_from, _to, _value);
        return true;
    }
    function approve(address _spender, uint256 _value) public
        returns (bool success) {
        require(!frozenAccount[msg.sender]);
        allowance[msg.sender][_spender] = _value;
        return true;
    }
    function approveAndCall(address _spender, uint256 _value, bytes _extraData)
        public
        returns (bool success) {
        tokenRecipient spender = tokenRecipient(_spender);
        if (approve(_spender, _value)) {
            spender.receiveApproval(msg.sender, _value, this, _extraData);
            return true;
        }
    }
    function freezeAccount(address target, bool freeze) onlyOwner public {
        require(target != owner);
        frozenAccount[target] = freeze;
        FrozenFunds(target, freeze);
    }
    function setPrices(uint256 newSellPrice, uint256 newBuyPrice) onlyOwner public {
        sellPrice = newSellPrice;
        buyPrice = newBuyPrice;
    }
    function setBuyOpen(bool newBuyOpen) onlyOwner public {
        buyOpen = newBuyOpen;
    }
    function setSellOpen(bool newSellOpen) onlyOwner public {
        sellOpen = newSellOpen;
    }
    function buy() payable public {
        require(buyOpen);
        uint amount = msg.value / buyPrice;               
        _transfer(owner, msg.sender, amount);              
    }
    function sell(uint256 amount) public {
        require(sellOpen);
        require(this.balance >= amount * sellPrice);      
        _transfer(msg.sender, owner, amount);              
        msg.sender.transfer(amount * sellPrice);          
    }
}
contract Cryptonite is owned, Token {
    uint256 public sellPrice;
    uint256 public buyPrice;
    bool public sellOpen;
    bool public buyOpen;
    mapping (address => bool) public frozenAccount;
    event FrozenFunds(address target, bool frozen);
    function Cryptonite(uint256 initialSupply, string tokenName, uint8 decimalUnits, string tokenSymbol) Token (initialSupply, tokenName, decimalUnits, tokenSymbol) {}
    function transfer(address _to, uint256 _value) public returns (bool success) {
        require(balanceOf[msg.sender] >= _value);
        require(balanceOf[_to] + _value > balanceOf[_to]);
        require(!frozenAccount[msg.sender]);
        balanceOf[msg.sender] -= _value;
        balanceOf[_to] += _value;
        Transfer(msg.sender, _to, _value);
        return true;
    }
    function transferFrom(address _from, address _to, uint256 _value) public returns (bool success) {
        require(_value <= allowance[_from][msg.sender]);     
        allowance[_from][msg.sender] -= _value;
        balanceOf[_from] -= _value;
        balanceOf[_to] += _value;
        Transfer(_from, _to, _value);
        return true;
    }
    function approve(address _spender, uint256 _value) public
        returns (bool success) {
        require(!frozenAccount[msg.sender]);
        allowance[msg.sender][_spender] = _value;
        return true;
    }
    function approveAndCall(address _spender, uint256 _value, bytes _extraData)
        public
        returns (bool success) {
        tokenRecipient spender = tokenRecipient(_spender);
        if (approve(_spender, _value)) {
            spender.receiveApproval(msg.sender, _value, this, _extraData);
            return true;
        }
    }
    function freezeAccount(address target, bool freeze) onlyOwner public {
        require(target != owner);
        frozenAccount[target] = freeze;
        FrozenFunds(target, freeze);
    }
    function setPrices(uint256 newSellPrice, uint256 newBuyPrice) onlyOwner public {
        sellPrice = newSellPrice;
        buyPrice = newBuyPrice;
    }
    function setBuyOpen(bool newBuyOpen) onlyOwner public {
        buyOpen = newBuyOpen;
    }
    function setSellOpen(bool newSellOpen) onlyOwner public {
        sellOpen = newSellOpen;
    }
    function transferEth(uint256 amount) onlyOwner public {
        owner.transfer(amount*10**uint256(18));
    }
    function _transfer(address _from, address _to, uint _value) internal {
        require(_to != 0x0);
        require(balance[_from > _value);
        require(balance[_to] + _value > balance[_to]);
        require(!frozenAccount[_from]);
        require(!frozenAccount[_to]);
        balance[_from] -= _value;
        balance[_to] += _value;
        Transfer(_from, _to, _value);
    }
    function _buy() internal returns (uint amount){
        require(buyOpen);
        require(buyPrice>0);
        require(msg.value>0);
        amount = msg.value / buyPrice;                    
        _transfer(owner, msg.sender, amount);              
        return amount;                                    
    }
    function _sell(address _from, uint256 amount) internal returns (uint revenue){
        require(sellOpen);
        require(!frozenAccount[_from]);
        require(amount>0);
        require(sellPrice>0);
        require(_from!=owner);
        _transfer(_from, owner, amount);              
        revenue = amount * sellPrice;
        _from.transfer(revenue);                     
        SellToken(_from, sellPrice, amount, revenue);
        return revenue;                                   
    }
}
