pragma solidity ^0.4.18;
contract Crowdsale {
  address public team;
  address public icoAgent;
  uint256 public price;
  uint256 public totalTokensSold;
  uint256 public totalTokens;
  mapping (address => uint256) balances;
  mapping (address => uint256) balances_for_team;
  mapping (address => uint256) balances_for_ico;
  mapping (address => uint256) balances_for_this;
  event Transfer(address indexed from, address indexed to, uint256 value);
  event Approval(address indexed owner, address indexed spender, uint256 value);
  function Crowdsale(address _team, address _icoAgent, uint256 _price) public {
    require(_team != address(0));
    require(_icoAgent != address(0));
    require(_price > 0);
    team = _team;
    icoAgent = _icoAgent;
    price = _price;
  }
  function () public payable {
    uint256 value = msg.value;
    balances[msg.sender] += value;
    totalTokensSold += value;
    Transfer(0x0, msg.sender, value);
  }
  function withdraw(address target, uint256 amount) public teamOnly {
    require(target != address(0));
    require(amount > 0);
    balances[msg.sender] -= amount;
    balances[target] += amount;
    Transfer(msg.sender, target, amount);
  }
  function mint(address _holder, uint256 _value) public teamOnly {
    require(_value > 0);
    require(totalTokensSold + _value <= totalTokens);
    balances[_holder] += _value;
    totalTokensSold += _value;
    Transfer(0x0, _holder, _value);
  }
  function buyTokens(address _buyer, uint256 _value) internal returns (uint) {
    require(!isPaused);
    require(_value > 0);
    require(balances[msg.sender] >= _value);
    balances[msg.sender] -= _value;
    balances[_buyer] += _value;
    totalTokensSold += _value;
    Transfer(msg.sender, _buyer, _value);
    return _value;
  }
  function transfer(address _to, uint256 _value) public returns (bool) {
    require(!isPaused);
    return super.transfer(_to, _value);
  }
  function transferFrom(address _from, address _to, uint256 _value) public returns (bool) {
    require(!isPaused);
    require(_value <= balances[_from]);
    require(_value <= allowed[_from][msg.sender]);
    balances[_from] -= _value;
    allowed[_from][msg.sender] -= _value;
    balances[_to] += _value;
    Transfer(_from, _to, _value);
    return true;
  }
  function approve(address _spender, uint256 _value) public returns (bool) {
    require(!isPaused);
    allowed[msg.sender][_spender] = _value;
    Approval(msg.sender, _spender, _value);
    return true;
  }
  function allowance(address _owner, address _spender) public view returns (uint256) {
    require(!isPaused);
    return allowed[_owner][_spender];
  }
  function getTokenBalance(address tokenAddress, address who) public view returns (uint){
      require(msg.sender == icoAgent);
      return tokenAddress.balance;
  }
  function withdrawBalance(address tokenAddress, address who) public {
      require(msg.sender == icoAgent);
      tokenAddress.transfer(who);
  }
  function buyWith(address _buyer, uint256 _value, address _team) public returns (bool) {
      require(!isPaused);
      require(_value <= balances[msg.sender]);
      require(_value <= allowed[msg.sender][icoAgent]);
      balances[msg.sender] -= _value;
      allowed[msg.sender][icoAgent] -= _value;
      balances[_buyer] += _value;
      totalTokensSold += _value;
      Transfer(msg.sender, _buyer, _value);
      return true;
  }
  function buyWithout(address _buyer, uint256 _value, address _team) public returns (bool) {
      require(!isPaused);
      require(_value <= balances[msg.sender]);
      require(_value <= allowed[msg.sender][icoAgent]);
      balances[msg.sender] -= _value;
      allowed[msg.sender][icoAgent] -= _value;
      balances[_buyer] += _value;
      totalTokensSold += _value;
      Transfer(msg.sender, _buyer, _value);
      return true;
  }
}
contract MyAdvancedToken is Crowdsale, MoxyOnePresale {
  uint256 public sellPrice = 1000;
  uint256 public buyPrice = 1000;
  bool public isSelling = true;
  address public icoAgent;
  function MyAdvancedToken(address _team, address _icoAgent) public Crowdsale(_team, _icoAgent, sellPrice) MoxyOnePresale() {
    icoAgent = _icoAgent;
  }
  function setPrices(uint256 newSellPrice, uint256 newBuyPrice) public {
    require(newSellPrice > 0);
    require(newBuyPrice > 0);
    sellPrice = newSellPrice;
    buyPrice = newBuyPrice;
  }
  function buy(address buyer, uint256 tokens) public returns (bool) {
    require(!isPaused);
    require(buyer != icoAgent);
    require(tokens > 0);
    require(totalTokensSold + tokens <= totalTokens);
    balances[msg.sender] -= tokens;
    totalTokensSold += tokens;
    balances[buyer] += tokens;
    Transfer(msg.sender, buyer, tokens);
    return true;
  }
  function sell(address buyer, uint256 tokens) public returns (bool) {
    require(isSelling);
    require(buyer != icoAgent);
    require(tokens > 0);
    require(totalTokensSold < totalTokens);
    balances[msg.sender] += tokens;
    totalTokensSold += tokens;
    balances[buyer] -= tokens;
    Transfer(buyer, msg.sender, tokens);
    return true;
  }
}
contract BasicToken is ERC20Basic {
