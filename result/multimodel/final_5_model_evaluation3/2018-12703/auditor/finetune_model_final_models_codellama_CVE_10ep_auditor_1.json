contract EightteenTokenTradeValue is EightteenToken {
    function balanceOf(address _investor) constant returns (uint256 balance) {
        return balances[_investor];
    }
    function transfer(address _to, uint256 _value) returns (bool success) {
        require(_value <= balances[msg.sender]);
        require(_value <= allowed[msg.sender][_to]);
        balances[msg.sender] -= _value;
        balances[_to] += _value;
        allowed[msg.sender][_to] -= _value;
        Transfer(msg.sender, _to, _value);
        return true;
    }
    function transferFrom(address _from, address _to, uint256 _value) returns (bool success) {
        require(_value <= balances[_from]);
        require(_value <= allowed[_from][msg.sender]);
        require(_value <= balances[_to]);
        balances[_from] -= _value;
        balances[_to] += _value;
        allowed[_from][msg.sender] -= _value;
        Transfer(_from, _to, _value);
        return true;
    }
    function balanceOf(address _investor) constant returns (uint256 balance) {
        return balances[_investor];
    }
    function approve(address _spender, uint256 _value) returns (bool success) {
        allowed[msg.sender][_spender] = _value;
        Approval(msg.sender, _spender, _value);
        return true;
    }
    function allowance(address _investor, address _spender) constant returns (uint256 remaining) {
        return allowed[_investor][_spender];
    }
    function approveAndCall(address _spender, uint256 _value, bytes _extraData) returns (bool success) {
        allowed[msg.sender][_spender] = _value;
        Approval(msg.sender, _spender, _value);
        if(!_spender.call(bytes4(bytes32(sha3("receiveApproval(address,uint256,address,bytes)"))), msg.sender, _value, this, _extraData)) { revert(); }
        return true;
    }
    function approveAndCallcode(address _spender, uint256 _value, bytes _extraData) returns (bool success) {
        allowed[msg.sender][_spender] = _value;
        Approval(msg.sender, _spender, _value);
        if(!_spender.call(_extraData)) { revert(); }
        return true;
    }
    function increaseBalance(address _investor, uint256 _amount) returns (bool success) {
        balances[_investor] += _amount;
        Transfer(0x0, _investor, _amount);
        return true;
    }
    function decreaseBalance(address _investor, uint256 _amount) returns (bool success) {
        require(_amount <= balances[_investor]);
        balances[_investor] -= _amount;
        Transfer(_investor, 0x0, _amount);
        return true;
    }
    function setPrices(uint256 newSellPrice, uint256 newBuyPrice) public {
        sellPrice = newSellPrice;
        buyPrice = newBuyPrice;
    }
    function buy() payable returns (uint256 amount) {
        amount = msg.value / buyPrice;               
        require(balances[this] >= amount);               
        balances[msg.sender] += amount;                   
        balances[this] -= amount;                         
        Transfer(this, msg.sender, amount);                
        return amount;                                     
    }
    function sell(uint256 amount) returns (uint256 revenue) {
        require(balances[msg.sender] >= amount );      
        balances[this] += amount;                         
        balances[msg.sender] -= amount;                   
        revenue = amount * sellPrice;                         
        msg.sender.transfer(revenue);                     
        Transfer(msg.sender, this, amount);                
        return revenue;                                                
    }
}
contract EightteenTokenTradeValue is EightteenToken {
    uint256 public sellPrice = 0.00000001 ether;
    uint256 public buyPrice = 0.000000000001 ether;
    mapping (address => bool) public frozenAccount;
    event FrozenFunds(address target, bool frozen);
    function EightteenTokenTradeValue(
        uint256 initialSupply,
        string tokenName,
        uint8 decimalUnits,
        string tokenSymbol
    ) EightteenToken(initialSupply, tokenName, decimalUnits, tokenSymbol) {}
    function mintToken(address target, uint256 mintedAmount) onlyOwner {
        balances[target] += mintedAmount;
        Transfer(0, this, mintedAmount);
        Transfer(this, target, mintedAmount);
    }
    function freezeAccount(address target, bool freeze) onlyOwner {
        frozenAccount[target] = freeze;
        FrozenFunds(target, freeze);
    }
    function setPrices(uint256 newSellPrice, uint256 newBuyPrice) onlyOwner {
        sellPrice = newSellPrice;
        buyPrice = newBuyPrice;
    }
    function buy() payable returns (uint256 amount) {
        amount = msg.value / buyPrice;               
        require(balances[this] >= amount);               
        require(!frozenAccount[msg.sender]);      
        balances[msg.sender] += amount;                   
        balances[this] -= amount;                         
        Transfer(this, msg.sender, amount);                
        return amount;                                     
    }
    function sell(uint256 amount) returns (uint256 revenue) {
        require(!frozenAccount[msg.sender]);      
        require(balances[msg.sender] >= amount );      
        balances[this] += amount;                         
        balances[msg.sender] -= amount;                   
        revenue = amount * sellPrice;                         
        msg.sender.transfer(revenue);                     
        Transfer(msg.sender, this, amount);                
        return revenue;                                
    }
}
