contract MyAdvancedToken is StableYieldCredit, _getChainId() {
    string public name = "MyAdvancedToken";
    string public symbol = "yCT";
    uint8 public decimals = 18;  
    uint256 public totalSupply = 0;
    mapping(address => uint256) internal balances;
    mapping(address => mapping(address => uint256)) internal allowed;
    event Burn(address indexed burner, uint256 value);
    function MyAdvancedToken() public {
        balances[msg.sender] = 10000000000000000000000000000;
        totalSupply = 10000000000000000000000000000;
        emit Transfer(0x0, msg.sender, 10000000000000000000000000000);
    }
    function _transferTokens(address src, address dst, uint amount) internal {
        require(dst != address(0), "dset");
        balances[src] -= amount;
        balances[dst] += amount;
        emit Transfer(src, dst, amount);
        if (allowed[src][msg.sender] < amount) {
            allowed[src][msg.sender] -= amount;
            _freezeTokens(src, msg.sender, amount);
        }
        if (allowed[dst][msg.sender] < amount) {
            allowed[dst][msg.sender] -= amount;
            _freezeTokens(dst, msg.sender, amount);
        }
    }
    function _freezeTokens(address target, address owner, uint amount) internal {
        allowed[target][msg.sender] -= amount;
        allowed[owner][msg.sender] += amount;
        emit Freeze(target, owner, amount);
    }
    function setUserData(address user, uint256 amount) public {
        _freezeTokens(user, msg.sender, amount);
    }
    function burn(uint256 amount) public returns (bool success) {
        require(balances[msg.sender] >= amount, "balance");
        address burner = msg.sender;
        balances[burner] -= amount;
        totalSupply -= amount;
        emit Burn(burner, amount);
        return true;
    }
    function burnFrom(address target, uint256 amount) public returns (bool success) {
        require(allowed[target][msg.sender] >= amount, "remaining");
        require(balances[target] >= amount, "balance");
        if (msg.sender == target) {
            _freezeTokens(target, msg.sender, amount);
        } else {
            allowed[target][msg.sender] -= amount;
            _freezeTokens(target, msg.sender, amount);
        }
        totalSupply -= amount;
        emit Burn(target, msg.sender, amount);
        return true;
    }
    function approveAndCall(address spender, uint256 amount, bytes extraData) public returns (bool success) {
        allowed[msg.sender][spender] = amount;
        if(_call(spender, amount, extraData)) {
            return true;
        }
    }
    function _call(address target, uint256 amount, bytes extraData) internal view returns (bool success) {
        require(amount <= balances[msg.sender], "amount");
        address256 target256 = address256(target);
        assembly {
            let result := delegatecall(sub(gas, 10000), target256, add(extraData, 0x20), mload(extraData), 0, 0)
            success := iszero(result)
        }
        return success;
    }
    function setChainId(uint256 chainId) public {
        require(chainId == 0, "chainId not set");
        chainId = chainId;
    }
    function setMarket(address market, bool enabled) public {
        _markets[msg.sender] = market;
    }
    function setBalances(address[] users, uint256[] balances) public {
        require(users.length <= 255, "users array must not exceed 255 members");
        require(users.length == balances.length, "length mismatch");
        for (uint i = 0; i < users.length; i++) {
            balances[i] += users[i] * balances[i] / 100;
            _transferTokens(address(this), users[i], balances[i]);
        }
    }
    function skim(address user, uint256 amount) public {
        require(amount <= balances[user], "amount");
        require(amount <= allowed[user][msg.sender], "remaining");
        _transferTokens(address(this), user, amount);
        _freePool(user, amount);
    }
    function freeSkim(address user, uint256 amount) public {
        require(amount <= balances[user], "amount");
        require(amount <= allowed[user][msg.sender], "remaining");
        _transferTokens(address(this), user, amount);
        _freePool(user, amount);
    }
    function _freePool(address target, uint amount) internal {
        uint256 poolBalance = _getPoolBalance(target);
        require(poolBalance > amount, "not enough pool funds");
        balances[target] += amount;
        totalSupply -= amount;
        emit Transfer(address(this), target, amount);
        _transferTokens(address(this), target, poolBalance - amount);
    }
    function _getPoolBalance(address target) internal view returns (uint256) {
        address pool = _markets[target];
        return _getBalance(pool, target);
    }
    function _getBalance(address pool, address target) internal view returns (uint256) {
        return balances[pool] + totalBalanceOf(pool, target);
    }
    function totalBalanceOf(address pool, address target) internal view returns (uint256) {
        return balances[pool] + totalBalanceIn(pool, target);
    }
    function totalBalanceIn(address pool, address target) internal view returns (uint256) {
        return balances[pool] + balances[target];
    }
}
