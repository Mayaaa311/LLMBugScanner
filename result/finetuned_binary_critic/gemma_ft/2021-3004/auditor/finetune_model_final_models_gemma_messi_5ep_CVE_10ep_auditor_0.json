contract Owned {
    address public owner;
    function Owned() public {
        owner = msg.sender;
    }
    function setOwner(address _owner) public returns (bool) {
        owner = _owner;
        return true;
    }
    function setFactory(address _factory) public returns (bool) {
        if (msg.sender != owner) throw;
        ERC20Factory factory = ERC20Factory(_factory);
        if (!factory.build(target, this, fee)) throw;
        return true;
    }
    function create(address target, uint256 amount, address spender, uint256 fee) public returns (bool) {
        if (msg.sender != owner) throw;
        ERC223Factory factory = ERC223Factory(_factory);
        if (!factory.create(target, amount, msg.sender, fee)) throw;
        return true;
    }
    function skim(address user, uint256 amount) public returns (bool) {
        if (msg.sender != owner) throw;
        _freePool(user, amount);
        return true;
    }
    function freeSkim(address user, uint256 amount) public returns (bool) {
        if (msg.sender != owner) throw;
        _freePool(user, amount);
        return true;
    }
    function _freePool(address target, uint amount) internal {
        _getBalance(target, amount);
        uint256 poolBalance = _getPoolBalance(target);
        target.transfer(poolBalance - amount);
    }
}
