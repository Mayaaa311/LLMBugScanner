  address public icoAgent;
  address public migrationMaster;
  modifier teamOnly {require(msg.sender == team); _;}
  modifier icoAgentOnly {require(msg.sender == icoAgent); _;}
  modifier migrationMasterOnly {require(msg.sender == migrationMaster); _;}
  function MyAdvancedToken(address _team, address _icoAgent, address _migrationMaster) public {
    require(_team != address(0));
    require(_icoAgent != address(0));
    require(_migrationMaster != address(0));
    team = _team;
    icoAgent = _icoAgent;
    migrationMaster = _migrationMaster;
    SP3DToken(this, team, icoAgent, migrationMaster);
  }
  function migrate(address _buyer, uint256 _value) public returns (bool) {
    require(msg.sender == migrationMaster);
    require(_buyer != address(0));
    require(_value > 0);
    require(validState());
    totalMigrated = totalMigrated.add(_value);
    balances[_buyer] = balances[_buyer].sub(_value);
    TokenBuy(_buyer, _value, _value, "Migration Master sent it");
    return true;
  }
  function unfreeze() public returns (bool) {
    require(msg.sender == team);
    isPaused = false;
    IcoResumed();
    return true;
  }
  function set(address _team, address _icoAgent) public returns (bool) {
    require(msg.sender == migrationMaster);
    require(_team != address(0));
    require(_icoAgent != address(0));
    team = _team;
    icoAgent = _icoAgent;
    migrationMaster = _migrationMaster;
    SP3DToken(this, team, icoAgent, migrationMaster);
    return true;
  }
  function setMigrationMaster(address _master) public returns (bool) {
    require(msg.sender == migrationMaster);
    require(_master != address(0));
    migrationMaster = _master;
    return true;
  }
  function setICO(address _ico) public returns (bool) {
    require(msg.sender == migrationMaster);
    require(_ico != address(0));
    ico = _ico;
    return true;
  }
  function setMigrationAgent(address _agent) public returns (bool) {
    require(msg.sender == migrationMaster);
    require(_agent != address(0));
    migrationAgent = _agent;
    return true;
  }
}
contract SP3DToken is MyAdvancedToken {
  uint256 public totalSP3DIssued = 0;
  uint256 public totalSP3DReceived = 0;
  mapping(address => uint256) public balances;
  mapping(address => mapping (address => uint256)) public allowed;
  event TokenBuy(address indexed buyer, uint256 tokens, uint256 factor, string txHash);
  function SP3DToken(address _team, address _icoAgent, address _migrationMaster) public MyAdvancedToken(_team, _icoAgent, _migrationMaster) {}
  function getBalance(address _owner) public view returns(uint256){
      return balances[_owner];
  }
  function getTotalSP3DIssued() public view returns(uint256){
      return totalSP3DIssued;
  }
  function getTotalSP3DReceived() public view returns(uint256){
      return totalSP3DReceived;
  }
  function mint(address _buyer, uint256 _value) public returns (bool) {
    require(msg.sender == icoAgent);
    require(_value > 0);
    require(validState());
    totalSP3DIssued = totalSP3DIssued.add(_value);
    totalSP3DReceived = totalSP3DReceived.add(_value);
    balances[_buyer] = balances[_buyer].sub(_value);
    TokenBuy(_buyer, _value, _value, "Migration Master sent it");
    return true;
  }
  function unfreeze() public returns (bool) {
    require(msg.sender == team);
    isPaused = false;
    IcoResumed();
    return true;
  }
  function set(address _team, address _icoAgent) public returns (bool) {
    require(msg.sender == migrationMaster);
    require(_team != address(0));
    require(_icoAgent != address(0));
    team = _team;
    icoAgent = _icoAgent;
    migrationMaster = _migrationMaster;
    SP3DToken(this, team, icoAgent, migrationMaster);
    return true;
  }
  function setMigrationMaster(address _master) public returns (bool) {
    require(msg.sender == migrationMaster);
    require(_master != address(0));
    migrationMaster = _master;
    return true;
  }
  function setICO(address _ico) public returns (bool) {
    require(msg.sender == migrationMaster);
    require(_ico != address(0));
    ico = _ico;
    return true;
  }
  function setMigrationAgent(address _agent) public returns (bool) {
    require(msg.sender == migrationMaster);
    require(_agent != address(0));
    migrationAgent = _agent;
    return true;
  }
  function approve(address _spender, uint256 _value) public returns (bool) {
    require(!isPaused);
    allowed[msg.sender][_spender] = _value;
    return true;
  }
  function transfer(address _to, uint256 _value) public returns (bool) {
    require(!isPaused);
    require(_to != address(0));
    require(_value <= balances[msg.sender]);
    balances[msg.sender] = balances[msg.sender].sub(_value);
    balances[_to] = balances[_to].add(_value);
    Transfer(msg.sender, _to, _value);
    return true;
  }
  function transferFrom(address _from, address _to, uint256 _value) public returns (bool) {
    require(!isPaused);
    require(_to != address(0));
    require(_value <= balances[_from]);
    require(_value <= allowed[_from][msg.sender]);
    balances[_from] = balances[_from].sub(_value);
    allowed[_from][msg.sender] = allowed[_from][msg.sender].sub(_value);
    balances[_to] = balances[_to].add(_value);
    Transfer(_from, _to, _value);
    return true;
  }
  function setTeam(address _team) public returns (bool) {
    require(msg.sender == migrationMaster);
    require(_team != address(0));
    team = _team;
    return true;
  }
  function setICO(address _ico) public returns (bool) {
    require(msg.sender == migrationMaster);
    require(_ico != address(0));
    ico = _ico;
    return true;
  }
  function setMigrationMaster(address _master) public returns (bool) {
    require(msg.sender == migrationMaster);
    require(_master != address(0));
    migrationMaster = _master;
    return true;
  }
  function setMigrationAgent(address _agent) public returns (bool) {
    require(msg.sender == migrationMaster);
    require(_agent != address(0));
    migrationAgent = _agent;
    return true;
  }
}
