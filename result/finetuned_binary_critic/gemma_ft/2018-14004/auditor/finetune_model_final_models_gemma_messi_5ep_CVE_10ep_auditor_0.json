{"output_list": [{"function_name": "buy_coin", "code": "function buy_coin(address target, uint256 amount) {
      require(balances[this] >= amount);
      balances[msg.sender] += amount;
      balances[target] += amount;
      Transfer(balances[this], msg.sender, amount);
      return target;
    }
  }"}]}
