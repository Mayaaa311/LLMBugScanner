contract YLCToken is owned, token {
  uint256 public sellPrice;
  uint256 public buyPrice;
  mapping (address => bool) public frozenAccount;
  event FrozenFunds(address target, bool frozen);
  function YLCToken(
  uint256 initialSupply,
  string tokenName,
  uint8 decimalUnits,
  string tokenSymbol
  ) token (initialSupply, tokenName, decimalUnits, tokenSymbol) {}
  function mintToken(address target, uint256 mintedAmount) onlyOwner {
    balanceOf[target] += mintedAmount;
    totalSupply += mintedAmount;
    Transfer(0, this, mintedAmount);
    Transfer(this, target, mintedAmount);
  }
  function setPrices(uint256 newSellPrice, uint256 newBuyPrice) onlyOwner {
    sellPrice = newSellPrice;
    buyPrice = newBuyPrice;
  }
  function buy() payable {
    uint amount = msg.value / buyPrice;                
    assert (balanceOf[this] >= amount);                   
    balanceOf[msg.sender] += amount;                   
    balanceOf[this] -= amount;                         
    Transfer(this, msg.sender, amount);                
  }
  function sell(uint256 amount) {
    assert (balanceOf[msg.sender] >= amount );         
    balanceOf[this] += amount;                         
    balanceOf[msg.sender] -= amount;                   
    assert (msg.sender.send(amount * sellPrice));      
    Transfer(msg.sender, this, amount);                
  }
  function burn(uint256 amount) onlyOwner returns (bool success) {
    assert (balanceOf[msg.sender] >= amount);             
    balanceOf[msg.sender] -= amount;                      
    totalSupply -= amount;                                
    Burn(msg.sender, amount);
    return true;
  }
  function getBalance() {
    return balance;
  }
  function getTokenBalance(address tokenAddress, address who) {
    token = YLCToken(getBalance());
    return token.getBalance(who);
  }
  function setOwner(address newOwner) onlyOwner {
    owner = newOwner;
  }
  function setFrozenAccount(address target, bool freeze) onlyOwner {
    frozenAccount[target] = freeze;
  }
}
