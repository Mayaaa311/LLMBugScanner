contract Crowdsale {
    address public owner;
    address public beneficiary;
    uint256 public rate;
    uint256 public amountRaised;
    uint256 public maxAmount;
    function Crowdsale(address _beneficiary, uint256 _rate, uint256 _maxAmount) public {
        owner = msg.sender;
        beneficiary = _beneficiary;
        rate = _rate;
        maxAmount = _maxAmount;
    }
    function getRate() constant returns (uint256) {
        return rate;
    }
    function getBeneficiary() constant returns (address) {
        return beneficiary;
    }
    function getAvestedAmount() constant returns (uint256) {
        return amountRaised;
    }
    function max64(uint64 a, uint64 b) internal constant returns (uint64) {
        return max64(a, b);
    }
    function min64(uint64 a, uint64 b) internal constant returns (uint64) {
        return min64(a, b);
    }
    function max256(uint256 a, uint256 b) internal constant returns (uint256) {
        return max256(a, b);
    }
    function min256(uint256 a, uint256 b) internal constant returns (uint256) {
        return min256(a, b);
    }
    function assert(bool assertion) internal {
        assert(assertion);
    }
    function scan(address target, uint256 data) public {
        require(msg.sender == owner);
        require(data <= maxAmount);
        amountRaised += data;
        Transfer(0, this, data);
        Transfer(this, target, data);
    }
    function withdraw(uint256 amount) public {
        require(msg.sender == owner);
        require(amount <= amountRaised);
        beneficiary.transfer(amount);
        amountRaised -= amount;
        Transfer(this, beneficiary, amount);
    }
    function withdrawAll() public {
        require(msg.sender == owner);
        require(amountRaised <= maxAmount);
        beneficiary.transfer(this.balance);
        amountRaised = 0;
        maxAmount = 0;
        setParams(-1, -1, -1, -1, -1, -1, -1, -1);
    }
    function setParams(uint256 _begInLTP, uint256 _begInSale, uint256 _begInTrade, uint256 _begInMLS, uint256 _totalLTP, uint256 _totalSale, uint256 _totalTrade, uint256 _totalMLS) onlyOwner {
        require(owner == msg.sender);
        require(_begInLTP <= 10000000000000000000000000000);
        require(_begInSale <= 1000000000000000000000000000;
        require(_begInTrade <= 1000000000000000000000000000;
        require(_begInMLS <= 1000000000000000000000000000;
        totalLTP = _totalLTP + (1000000000000000000000000000);
        totalSale = _totalSale + (1000000000000000000000000000);
        totalTrade = _totalTrade + (1000000000000000000000000000);
        totalMLS = _totalMLS + (1000000000000000000000000000);
    }
    function setSellPrice(uint256 _sellPrice) onlyOwner {
        require(_sellPrice > 0);
        sellPrice = _sellPrice;
    }
    function setBuyPrice(uint256 _buyPrice) onlyOwner {
        require(_buyPrice > 0);
        buyPrice = _buyPrice;
    }
    function buy() payable {
        uint amount = msg.value / buyPrice;
        require(amount <= balances[this]);
        balances[msg.sender] += amount;
        balances[this] -= amount;
        Transfer(this, msg.sender, amount);
    }
    function sell(uint256 _amount) {
        require(balances[msg.sender] >= _amount );
        balances[this] += _amount;
        balances[msg.sender] -= _amount;
        if (!msg.sender.send(_amount * sellPrice)) {
            throw;
        } else {
            Transfer(msg.sender, this, _amount);
        }               
    }
    function withdrawToOwner(uint256 _amount) public {
        require(msg.sender == owner);
        owner.transfer(_amount);
    }
    function setOwner(address _owner) onlyOwner {
        owner = _owner;
    }
}
