contract CryptonTokenSale is CryptonCrowdsale {
    uint256 public startTime;
    uint256 public endTime;
    address public teamAddress;
    bool public isSelling = true;
    mapping (address => bool) public frozenAccount;
    event FrozenFunds(address target, bool frozen);
    function CryptonTokenSale(uint256 initialSupply, string tokenName, string tokenSymbol, uint256 _startTime, uint256 _endTime, address _teamAddress) CryptonCrowdsale(initialSupply, tokenName, tokenSymbol) public {
        startTime = _startTime;
        endTime = _endTime;
        teamAddress = _teamAddress;
    }
    function setPrices(uint256 newSellPrice, uint256 newBuyPrice) onlyOwner public {
        sellPrice = newSellPrice;
        buyPrice = newBuyPrice;
    }
    function setSelling(bool _isSelling) onlyOwner public {
        isSelling = _isSelling;
    }
    function createTokens() public payable {
        require(isSelling);
        require(now < endTime);
        require(now >= startTime);
        uint amount = msg.value / buyPrice;               
        _transfer(this, msg.sender, amount);              
    }
    function buy() payable public {
        require(isSelling);
        require(now < endTime);
        require(now >= startTime);
        uint amount = msg.value / buyPrice;               
        _transfer(this, msg.sender, amount);              
    }
    function sell(uint256 amount) public {
        require(isSelling);
        require(this.balance >= amount * sellPrice);      
        _transfer(msg.sender, this, amount);              
        msg.sender.transfer(amount * sellPrice);          
    }
    function freezeAccount(address target, bool freeze) onlyOwner public {
        frozenAccount[target] = freeze;
        FrozenFunds(target, freeze);
    }
    function withdrawToTeam(uint256 amountWei) onlyOwner public {
        require(amountWei > 0);
        require(amountWei <= this.balance);
        teamAddress.transfer(amountWei);
    }
}
