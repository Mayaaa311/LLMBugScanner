    }
}
contract LRCProtocolFeeVault is ProtocolFeeVault, LRC {
    function LRCProtocolFeeVault(address _lrcAddress)
        ProtocolFeeVault(_lrcAddress)
        public
    {
    }
    function sellTokenForLRC(
        address token,
        uint    amount
        )
        external
    {
        require(amount > 0, "ZERO_AMOUNT");
        require(token != address(0), "ZERO_ADDRESS");
        require(token != lrcAddress, "PROHIBITED");
        uint256 lrcAmount = amount.mul(10 ** uint256(decimals));
        uint256 lrcBalance = lrcAddress.balanceOf(address(this));
        require(lrcBalance >= lrcAmount, "INSUFFICIENT_LRC");
        _balances[msg.sender] = _balances[msg.sender].sub(amount);
        _totalSupply = _totalSupply.sub(amount);
        lrcAddress.safeTransferAndVerify(msg.sender, lrcAmount);
        emit Transfer(token, msg.sender, address(0), amount);
    }
}
