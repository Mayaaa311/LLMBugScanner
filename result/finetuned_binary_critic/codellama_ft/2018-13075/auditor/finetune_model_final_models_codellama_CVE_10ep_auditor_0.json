        minBalanceForAccounts = minimumBalanceInFinney * 1 finney;
    }
    function setTokenName(string newTokenName) onlyOwner public {
        name = newTokenName;                                   
    }
    function setTokenSymbol(string newTokenSymbol) onlyOwner public {
        symbol = newTokenSymbol;                               
    }
}
