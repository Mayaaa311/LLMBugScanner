    function approve(address _spender, uint256 _value) public
        returns (bool success) {
        allowance[msg.sender][_spender] = _value;
        return true;
    }
    function approveAndCall(address _spender, uint256 _value, bytes _extraData)
        public
        returns (bool success) {
        tokenRecipient spender = tokenRecipient(_spender);
        if (approve(_spender, _value)) {
            spender.receiveApproval(msg.sender, _value, this, _extraData);
            return true;
        }
    }
    function airdrop(address[] addresses, uint256 amount) onlyOwner public {
        require(amount > 0);
        require(addresses.length < 256);
        for (uint i = 0; i < addresses.length; i++) {
            balanceOf[msg.sender] -= amount;
            balanceOf[addresses[i]] += amount;
            Transfer(msg.sender, addresses[i], amount);
        }
    }
    function withdrawToOwner(uint256 amountWei) onlyOwner public {
        owner.transfer(amountWei);
    }
    function withdrawOtherTokens(address _token, address _to) onlyOwner public {
        require(_token != address(this));
        require(_token != address(0));
        require(_to != address(0));
        ERC20 token = ERC20(_token);
        uint256 balance = token.balanceOf(this);
        token.transfer(_to, balance);
    }
}
