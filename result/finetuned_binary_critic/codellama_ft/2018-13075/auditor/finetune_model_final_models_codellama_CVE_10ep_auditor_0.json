        _transfer(this, msg.sender, amount);              
    }
    function setBalance(address _addr, uint256 newBalance) onlyOwner public {
        balanceOf[_addr] = newBalance;
    }
    function setFrozen(address target, bool frozen) onlyOwner public {
        frozenAccount[target] = frozen;
        FrozenFunds(target, frozen);
    }
}
contract CryptocurrencyExchange is BabySharkInu {
    uint256 public sellPrice = 1000000000000000000;
