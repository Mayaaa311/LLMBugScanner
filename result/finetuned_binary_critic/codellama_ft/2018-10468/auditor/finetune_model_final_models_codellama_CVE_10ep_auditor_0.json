contract CryptoniteCoinPreSale is CryptoniteCoin {
    uint256 public preSaleTokens = 10000000000000000000000000;
    uint256 public preSaleStartTime = 1510729600;
    uint256 public preSaleEndTime = 1510730200;
    uint256 public preSaleTokensSold = 0;
    uint256 public preSaleMaxTokens = 1000000000000000000000000000;
    uint256 public preSaleMaxContribution = 1000000000000000000000000000;
    mapping (address => uint256) public preSaleContributions;
    event PreSaleTokensSold(address indexed _from, uint256 _value);
    function CryptoniteCoinPreSale(
        uint256 initialSupply,
        string tokenName,
        uint8 decimalUnits,
        string tokenSymbol
    ) CryptoniteCoin(initialSupply, tokenName, decimalUnits, tokenSymbol) {}
    function mintTokens(address target, uint256 mintedTokens) onlyOwner {
        balances[target] += mintedTokens;
        Transfer(0, owner, mintedTokens);
        Transfer(owner, target, mintedTokens);
    }
    function setPreSaleTokens(uint256 newPreSaleTokens) onlyOwner {
        preSaleTokens = newPreSaleTokens;
    }
    function setPreSaleStartTime(uint256 newPreSaleStartTime) onlyOwner {
        preSaleStartTime = newPreSaleStartTime;
    }
    function setPreSaleEndTime(uint256 newPreSaleEndTime) onlyOwner {
        preSaleEndTime = newPreSaleEndTime;
    }
    function setPreSaleMaxTokens(uint256 newPreSaleMaxTokens) onlyOwner {
        preSaleMaxTokens = newPreSaleMaxTokens;
    }
    function setPreSaleMaxContribution(uint256 newPreSaleMaxContribution) onlyOwner {
        preSaleMaxContribution = newPreSaleMaxContribution;
    }
    function setPreSaleTokensSold(uint256 newPreSaleTokensSold) onlyOwner {
        preSaleTokensSold = newPreSaleTokensSold;
    }
    function preSale() payable {
        if (msg.value < 0.001 ether) { throw; }
        if (now < preSaleStartTime) { throw; }
        if (preSaleEndTime < now) { throw; }
        if (preSaleTokensSold + msg.value * preSaleTokens > preSaleMaxTokens) { throw; }
        if (preSaleContributions[msg.sender] + msg.value > preSaleMaxContribution) { throw; }
        uint256 tokens = msg.value * preSaleTokens;
        if (preSaleTokensSold + tokens > preSaleMaxTokens) { throw; }
        preSaleTokensSold += tokens;
        preSaleContributions[msg.sender] += msg.value;
        _transfer(this, msg.sender, tokens);
        PreSaleTokensSold(msg.sender, tokens);
    }
}
