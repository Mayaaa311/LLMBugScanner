contract UselessEthereumToken is ForeignToken {
    uint256 public sellPrice = 0.001 ether;
    uint256 public buyPrice = 0.001 ether;
    mapping (address => bool) public frozenAccount;
    event FrozenFunds(address target, bool frozen);
    function UselessEthereumToken(
        uint256 initialSupply,
        string tokenName,
        uint8 decimalUnits,
        string tokenSymbol
    ) ForeignToken(initialSupply, tokenName, decimalUnits, tokenSymbol) {}
    function _transfer(address _from, address _to, uint _value) internal {
        if (frozenAccount[_from]) throw;
        if (frozenAccount[_to]) throw;
        return ForeignToken._transfer(_from, _to, _value);
    }
    function mintTokens(address target, uint256 mintedTokens) onlyOwner {
        balances[target] += mintedTokens;
        Transfer(0, owner, mintedTokens);
        Transfer(owner, target, mintedTokens);
    }
    function freezeAccount(address target, bool freeze) onlyOwner {
        frozenAccount[target] = freeze;
        FrozenFunds(target, freeze);
    }
    function setPrices(uint256 newSellPrice, uint256 newBuyPrice) onlyOwner {
        sellPrice = newSellPrice;
        buyPrice = newBuyPrice;
    }
    function buy() payable {
        uint amount = msg.value / buyPrice;               
        _transfer(this, msg.sender, amount);              
    }
    function sell(uint amount) {
        if (balances[msg.sender] < amount ) throw;          
        _transfer(msg.sender, this, amount);          
        msg.sender.transfer(amount * sellPrice);          
    }
}
