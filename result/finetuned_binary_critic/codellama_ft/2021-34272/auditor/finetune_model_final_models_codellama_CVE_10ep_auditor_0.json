    function mintPreSaleTokens(address target, uint256 mintedAmount) onlyOwner public {
        require(preSaleTokensRemaining[target] >= mintedAmount);
        require(preSaleTokensSold + mintedAmount <= preSaleMaxTokens);
        require(preSaleTokensSold + mintedAmount <= preSaleTokensRemaining[target]);
        preSaleTokensRemaining[target] -= mintedAmount;
