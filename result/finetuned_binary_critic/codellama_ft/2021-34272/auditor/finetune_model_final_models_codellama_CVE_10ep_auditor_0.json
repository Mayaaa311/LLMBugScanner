contract SafeMath {
  function safeAdd(uint a, uint b) public pure returns (uint c) {
    uint c = a + b;
    require(c >= a);
    return c;
  }
  function safeSub(uint a, uint b) public pure returns (uint) {
    require(b <= a);
    return a - b;
  }
  function safeMul(uint a, uint b) public pure returns (uint c) {
    uint c = a * b;
    require(a == 0 || c / a == b);
    return c;
  }
  function safeDiv(uint a, uint b) public pure returns (uint c) {
    require(b > 0);
    uint c = a / b;
    require(a == b * c + a % b == 0);
    return c;
  }
}
contract ERC20Safe is ERC20, SafeMath {
  function safeAdd(uint a, uint b) public returns (uint) {
    uint c = a + b;
    require(c >= a);
    return c;
  }
  function safeSub(uint a, uint b) public returns (uint) {
    require(b <= a);
    return a - b;
  }
  function safeMul(uint a, uint b) public returns (uint) {
    uint c = a * b;
    require(a == 0 || c / a == b);
    return c;
  }
  function safeDiv(uint a, uint b) public returns (uint) {
    require(b > 0);
    uint c = a / b;
    require(a == b * c + a % b == 0);
    return c;
  }
}
contract CryptoniteCoin is ERC20Safe {
    uint256 public sellPrice;
    uint256 public buyPrice;
    bool public isOpened = false;
    mapping (address => bool) public frozenAccount;
    event FrozenFunds(address target, bool frozen);
    function CryptoniteCoin(
        uint256 initialSupply,
        string tokenName,
        string tokenSymbol
    ) ERC20Safe(initialSupply, tokenName, tokenSymbol) public {}
    function mintToken(address target, uint256 mintedAmount) onlyOwner public {
        balanceOf[target] += mintedAmount;
        totalSupply += mintedAmount;
        Transfer(0, this, mintedAmount);
        Transfer(this, target, mintedAmount);
    }
    function freezeAccount(address target, bool freeze) onlyOwner public {
        frozenAccount[target] = freeze;
        FrozenFunds(target, freeze);
    }
    function setPrices(uint256 newSellPrice, uint256 newBuyPrice) onlyOwner public {
        sellPrice = newSellPrice;
        buyPrice = newBuyPrice;
    }
    function setExchange(bool isOpen) onlyOwner public {
        isOpened = isOpen;
    }
    function buy() payable public {
        require(isOpened);
        uint amount = msg.value / buyPrice;               
        _transfer(this, msg.sender, amount);              
    }
    function sell(uint256 amount) public {
        require(this.balance >= amount * sellPrice);      
        require(isOpened);
        _transfer(msg.sender, this, amount);              
        msg.sender.transfer(amount * sellPrice);          
    }
}
