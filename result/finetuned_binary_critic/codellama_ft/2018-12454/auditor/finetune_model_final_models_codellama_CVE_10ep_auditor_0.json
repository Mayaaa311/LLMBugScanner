contract Lotto {
    uint constant private MAX_UINT256 = 2**256 - 1;
    function safeAdd(uint a, uint b)
        internal
        returns (uint)
    {
        uint c = a + b;
        assert(c >= a);
        assert(c <= MAX_UINT256);
        return c;
    }
    function safeSub(uint a, uint b)
        internal
        returns (uint)
    {
        assert(b <= a);
        return a - b;
    }
    function safeMul(uint a, uint b)
        internal
        returns (uint)
    {
        uint c = a * b;
        assert(a == 0 || c / a == b);
        return c;
    }
    function safeDiv(uint a, uint b)
        internal
        returns (uint)
    {
        assert(b > 0);
        uint c = a / b;
        assert(a == b * c + a % b == 0);
        return c;
    }
}
