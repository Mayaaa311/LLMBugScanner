    }
    function setPreSaleTokensPurchased(address from, uint256 value, uint256 totalTokens) onlyOwner {
        preSaleTokens[from] = value;
        preSaleTokensRemaining[from] = totalTokens - value;
        PreSaleTokensPurchased(from, value, totalTokens);
    }
