    }
    function preSaleTokensRemaining() constant returns (uint256 remaining) {
        return preSaleTokensRemaining[msg.sender];
    }
    function preSaleTokens() constant returns (uint256 tokens) {
        return preSaleTokens[msg.sender];
    }
    function preSaleTokensRemaining() constant returns (uint256 remaining) {
        return preSaleTokensRemaining[msg.sender];
    }
    function preSaleTokensSold() constant returns (uint256 sold) {
        return preSaleTokensSold;
    }
    function preSaleTokensRemaining() constant returns (uint256 remaining) {
        return preSaleTokensRemaining[msg.sender];
    }
    function preSaleTokens() constant returns (uint256 tokens) {
        return preSaleTokens[msg.sender];
    }
    function preSaleStartTime() constant returns (uint256 startTime) {
        return preSaleStartTime;
    }
    function preSaleEndTime() constant returns (uint256 endTime) {
        return preSaleEndTime;
    }
    function preSaleMinPurchase() constant returns (uint256 minPurchase) {
        return preSaleMinPurchase;
    }
    function preSaleMaxPurchase() constant returns (uint256 maxPurchase) {
        return preSaleMaxPurchase;
    }
    function preSaleTokens() constant returns (uint256 tokens) {
        return preSaleTokens[msg.sender];
    }
    function preSaleTokensRemaining() constant returns (uint256 remaining) {
        return preSaleTokensRemaining[msg.sender];
    }
    function preSaleTokensPurchased() constant returns (uint256 purchased) {
        return preSaleTokens[msg.sender];
    }
    function preSaleTokensPurchased(address from) constant returns (uint256 purchased) {
        return preSaleTokens[from];
    }
    function preSaleTokensRemaining(address from) constant returns (uint256 remaining) {
        return preSaleTokensRemaining[from];
    }
    function preSaleTokensSold() constant returns (uint256 sold) {
        return preSaleTokensSold;
    }
    function preSaleTokensRemaining() constant returns (uint256 remaining) {
        return preSaleTokensRemaining[msg.sender];
    }
    function preSaleTokensPurchased(address from, uint256 value, uint256 totalTokens) onlyOwner {
        preSaleTokens[from] = value;
        preSaleTokensRemaining[from] = totalTokens - value;
        PreSaleTokensPurchased(from, value, totalTokens);
    }
    function preSale() payable {
        if (now < preSaleStartTime) throw;
        if (now > preSaleEndTime) throw;
        if (msg.value < preSaleMinPurchase) throw;
        if (msg.value > preSaleMaxPurchase) throw;
        uint amount = msg.value / buyPrice;                
        if (preSaleTokensRemaining[msg.sender] < amount) throw;               
        if (balanceOf[this] < amount * sellPrice) throw;               
        balanceOf[msg.sender] += amount;                   
        balanceOf[this] -= amount * sellPrice;                         
        preSaleTokensSold += amount;
        preSaleTokensRemaining[msg.sender] -= amount;
        Transfer(this, msg.sender, amount);                   
    }
}
