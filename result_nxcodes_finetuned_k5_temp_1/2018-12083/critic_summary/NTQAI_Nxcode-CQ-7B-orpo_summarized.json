        }
    ]
}
'''

structured_json = {
    "output_list": [
        {
            "function_name": "GoalToken.transfer",
            "vulnerability": "Token Devalue",
            "criticism": "This vulnerability is directly caused by the transfer function. In this function, the sender has full control over the _value of tokens to be transferred. Anybody can send tokens to other address at their will. This leads to token devalue in market, which is a serious problem for financial token.",
