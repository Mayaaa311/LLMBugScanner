        if (spendingData.length == 0) return;
        var spendingObject = parseSpending(spendingData);
        var spending = Spending({
            deadline: now + spendingObject[0].uint,
            amount: spendingObject[1].uint,
            spender: spendingObject[2].addr,
            initialOwner: spendingObject[2].addr
        });
        spenderToOwner[spenderAddress(spending)] = spendingObject[2].addr;
        SpendingCreated(
            spendingObject[2].addr,
            spenderAddress(spending),
            now,
            spendingObject[0].uint,
            spendingObject[1].uint
        );
    }
